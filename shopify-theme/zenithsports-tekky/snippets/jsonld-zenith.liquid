{% comment %}
  JSON-LD structured data for AI / SEO discoverability.

  Render in layout/theme.liquid right before </head>:

    {% render 'jsonld-zenith' %}

  Emits three schemas:
    1. Organization — Zenith Sports, LLC + founders + sameAs links
    2. WebSite — with SearchAction so Google + ChatGPT can surface
       the site search box in their answers
    3. Product (conditional) — only when on a product page, emits
       full Shopify product JSON-LD with variants, price, brand,
       SKU, image gallery, in-stock status

  Why this matters: AI crawlers (ChatGPT browse, Claude browse,
  Perplexity, Gemini, Bing Copilot) prefer clean structured data
  over JS-rendered Shopify pages. Without this, AI answers about
  "TEKKY ball" / "Zenith Sports" fall back to whatever they scraped
  from random review sites — usually wrong, often outdated.

  Pairs with the llms.txt file at /llms.txt (separate page template).
{% endcomment %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Zenith Sports, LLC",
  "alternateName": ["TEKKY", "Zenith Sports"],
  "url": "{{ shop.url }}",
  "logo": "https://zenithsports.org/cdn/shop/files/Zenith_Sports-02-removebg-preview.png",
  "description": "Patent-pending TEKKY™ technical training ball — smaller surface, full FIFA-5 weight. Built by Philip Lund + Paul Hanson, 40+ combined years coaching U.S. youth soccer. Used by Rec, Travel, ECNL, MLS Next clubs.",
  "founder": [
    { "@type": "Person", "name": "Philip Lund", "jobTitle": "Co-Founder" },
    { "@type": "Person", "name": "Paul Hanson",  "jobTitle": "Co-Founder · 40+ years coaching" }
  ],
  "email": "info@zenithsports.org",
  "sameAs": [
    "https://www.instagram.com/tekkybyzenithsports/",
    "https://www.facebook.com/p/TEKKY-by-Zenith-Sports-61578752395790/",
    "https://www.youtube.com/@TEKKYbyZenithSports"
  ],
  "makesOffer": [
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Product",
        "name": "The TEKKY™ · Patent-pending training ball",
        "description": "Smaller than regulation for control, full FIFA-5 spec weight for real strength transfer."
      },
      "priceCurrency": "USD",
      "price": "59.95",
      "url": "https://zenithsports.org/cart/45347164389551:1"
    }
  ]
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Zenith Sports · TEKKY",
  "url": "{{ shop.url }}",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "{{ shop.url }}/search?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
}
</script>

{%- if template contains 'product' and product != blank -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "description": {{ product.description | strip_html | truncate: 1000 | json }},
    "sku": {{ product.selected_or_first_available_variant.sku | json }},
    "brand": {
      "@type": "Brand",
      "name": "TEKKY"
    },
    "category": "Soccer Training Equipment",
    "audience": { "@type": "PeopleAudience", "suggestedMinAge": 5 },
    "additionalProperty": [
      { "@type": "PropertyValue", "name": "Control surface", "value": "Smaller than a regulation soccer ball" },
      { "@type": "PropertyValue", "name": "Weight", "value": "Full FIFA Size 5 match spec" }
    ],
    "image": [
      {%- for img in product.images limit: 8 -%}
        "https:{{ img | image_url: width: 1200 }}"{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ],
    "offers": {
      "@type": "Offer",
      "url": "{{ shop.url }}{{ product.url }}",
      "priceCurrency": "{{ cart.currency.iso_code }}",
      "price": "{{ product.selected_or_first_available_variant.price | money_without_currency | replace: ',', '' }}",
      "availability": "{% if product.selected_or_first_available_variant.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
      "seller": {
        "@type": "Organization",
        "name": "Zenith Sports, LLC"
      }
    }
  }
  </script>
{%- endif -%}

{%- comment -%} HowTo — the 4-week method (visible on homepage). Targets "how to improve first touch", "how to train with a smaller ball". {%- endcomment -%}
{%- if template == 'index' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to improve first touch with the TEKKY™ training ball",
  "description": "A 4-week technical training method using the TEKKY™ — a smaller soccer ball with full FIFA-5 weight — to sharpen first touch, footwork, and ball control.",
  "totalTime": "P4W",
  "supply": [{ "@type": "HowToSupply", "name": "TEKKY™ training ball" }],
  "step": [
    { "@type": "HowToStep", "position": 1, "name": "Pick 3 drills", "text": "Choose 3 drills from the free 22-drill library — one each for gather, dribble, and finish. Start with the Warm Up tier." },
    { "@type": "HowToStep", "position": 2, "name": "Train 10–15 minutes, 3x a week", "text": "Quality over quantity. Pristine reps build technique faster than tired ones." },
    { "@type": "HowToStep", "position": 3, "name": "Level up after week 2", "text": "Add 2 Beginner drills, drop the easiest Warm Up, and always keep something challenging." },
    { "@type": "HowToStep", "position": 4, "name": "Week 4: pick up a regulation ball", "text": "After 4 weeks on the TEKKY, a match ball feels bigger, slower, and easier to control. The transfer is automatic." }
  ]
}
</script>
{%- endif -%}

{%- comment -%} BlogPosting + Breadcrumb — fires automatically on every blog article. {%- endcomment -%}
{%- if article != blank -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ article.title | json }},
  "description": {{ article.excerpt_or_content | strip_html | truncate: 200 | json }},
  "image": [{% if article.image %}"https:{{ article.image | image_url: width: 1200 }}"{% endif %}],
  "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "author": { "@type": "Organization", "name": "Zenith Sports, LLC" },
  "publisher": {
    "@type": "Organization",
    "name": "Zenith Sports, LLC",
    "logo": { "@type": "ImageObject", "url": "https://zenithsports.org/cdn/shop/files/Zenith_Sports-02-removebg-preview.png" }
  },
  "mainEntityOfPage": "{{ shop.url }}{{ article.url }}"
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ shop.url }}" },
    { "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": "{{ shop.url }}{{ blog.url }}" },
    { "@type": "ListItem", "position": 3, "name": {{ article.title | json }} }
  ]
}
</script>
{%- endif -%}
