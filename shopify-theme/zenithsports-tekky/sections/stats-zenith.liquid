{% comment %}
  3 outcome / credibility stat cards. Quick scannable proof points.
{% endcomment %}

<section class="zenith-section zenith-stats">
  <div class="zenith-container">
    <div class="zenith-stats__grid">
      {% for block in section.blocks %}
        <article class="zenith-stat-card">
          <div class="zenith-stat-card__number">{% render 'zenith-text', text: block.settings.number %}</div>
          <div class="zenith-stat-card__label">{% render 'zenith-text', text: block.settings.label %}</div>
          {% if block.settings.note != blank %}
            <p class="zenith-stat-card__note">{% render 'zenith-text', text: block.settings.note %}</p>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .zenith-stats {
    background: var(--zenith-navy);
    color: #fff;
    padding: 4rem 0;
  }
  @media (min-width: 768px) { .zenith-stats { padding: 5rem 0; } }
  .zenith-stats__grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .zenith-stats__grid { grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  }
  .zenith-stat-card {
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 0.85rem;
    padding: 2rem 1.75rem;
  }
  .zenith-stat-card__number {
    font-family: var(--zenith-font-display);
    font-weight: 900;
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--zenith-lime);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .zenith-stat-card__label {
    margin-top: 0.85rem;
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: #fff;
  }
  .zenith-stat-card__note {
    margin-top: 0.6rem;
    font-size: 1rem;
    color: rgba(255,255,255,0.78);
    line-height: 1.55;
  }
</style>

{% schema %}
{
  "name": "Zenith Stats",
  "tag": "section",
  "class": "zenith-stats-section",
  "settings": [],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat card",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "number", "label": "Big number / phrase" },
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "note", "label": "Note (small text under label)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Zenith Stats",
      "blocks": [
        { "type": "stat", "settings": { "number": "10 min/day", "label": "All it takes", "note": "3 reps a week beats one long session" } },
        { "type": "stat", "settings": { "number": "4 weeks", "label": "Visible improvement", "note": "First touch, mastery, confidence" } },
        { "type": "stat", "settings": { "number": "1 ball", "label": "Lifetime training", "note": "Patent-pending -- built to last" } }
      ]
    }
  ]
}
{% endschema %}
