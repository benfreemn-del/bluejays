    margin: 0.35rem 0 0.65rem;
    font-size: 15px; font-weight: 900;
    text-transform: uppercase; letter-spacing: -0.01em;
    color: var(--zenith-navy);
  }
  .zenith-tg__principle-body {
    font-size: 0.875rem;
    color: #475569;
    line-height: 1.6;
    margin: 0;
  }

  .zenith-tg__week {
    border-top: 1px solid #cbd5e1;
    padding-top: 1.25rem;
    margin-bottom: 1.75rem;
  }
  .zenith-tg__week-head {
    display: flex; align-items: baseline; justify-content: space-between;
    flex-wrap: wrap; gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .zenith-tg__week-title {
    font-size: 1.15rem; font-weight: 900;
    text-transform: uppercase; letter-spacing: -0.01em;
    color: var(--zenith-navy);
    margin: 0;
  }
  .zenith-tg__week-focus {
    font-size: 11px; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.18em;
    color: var(--zenith-electric);
  }
  .zenith-tg__sessions {
    display: grid; gap: 0.75rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) { .zenith-tg__sessions { grid-template-columns: repeat(3, 1fr); } }
