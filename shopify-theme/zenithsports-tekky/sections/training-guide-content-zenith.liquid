    border: 1px solid #e2e8f0;
    background: #f8fafc;
    padding: 1rem;
    border-radius: 4px;
  }
  .zenith-tg__session-head {
    display: flex; align-items: center; gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .zenith-tg__session-day {
    display: inline-flex; align-items: center; justify-content: center;
    width: 28px; height: 28px;
    border-radius: 50%;
    background: var(--zenith-navy);
    color: #fff;
    font-size: 12px; font-weight: 800;
    letter-spacing: 0.1em;
  }
  .zenith-tg__session-title {
    font-size: 14px; font-weight: 900;
    text-transform: uppercase; letter-spacing: -0.01em;
    color: var(--zenith-navy);
  }
  .zenith-tg__session-body {
    font-size: 12px;
    color: #475569;
    line-height: 1.6;
    margin: 0;
  }

  .zenith-tg__guard-grid {
    display: grid; gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) { .zenith-tg__guard-grid { grid-template-columns: repeat(2, 1fr); } }
  .zenith-tg__guard {
    padding: 0.25rem 0 0.25rem 1rem;
  }
  .zenith-tg__guard--always { border-left: 4px solid #10b981; }
  .zenith-tg__guard--never { border-left: 4px solid #f43f5e; }
  .zenith-tg__guard-head {
    font-size: 11px; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.28em;
    margin: 0 0 0.75rem;
  }
