  .zenith-tg__guard--never .zenith-tg__guard-head { color: #be123c; }
  .zenith-tg__guard ul {
    list-style: none; padding: 0; margin: 0;
    display: grid; gap: 0.6rem;
  }
  .zenith-tg__guard li {
    display: flex; gap: 0.5rem;
    font-size: 14px;
    color: #1e293b;
    line-height: 1.55;
  }
  .zenith-tg__check { color: #10b981; font-weight: 700; }
