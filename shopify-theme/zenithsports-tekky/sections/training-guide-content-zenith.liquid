  .zenith-tg__close {
    border-top: 4px solid var(--zenith-navy);
    padding-top: 2rem;
    margin-top: 3rem;
  }
  .zenith-tg__pullquote {
    font-family: ui-serif, Georgia, "Times New Roman", serif;
    font-size: clamp(1.15rem, 2.2vw, 1.5rem);
    font-style: italic;
    color: var(--zenith-navy);
    line-height: 1.5;
    max-width: 48rem;
  }
  .zenith-tg__pullquote-cite {
    margin-top: 0.75rem;
    font-size: 11px; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.18em;
    color: var(--zenith-electric);
  }
  .zenith-tg__cta-grid {
    display: grid; gap: 0.75rem;
    grid-template-columns: 1fr;
    margin-top: 2.5rem;
  }
  @media (min-width: 768px) { .zenith-tg__cta-grid { grid-template-columns: repeat(3, 1fr); } }
  .zenith-tg__cta {
    display: block;
    padding: 1.25rem;
    border-radius: 4px;
    text-decoration: none;
  }
  .zenith-tg__cta--dark { background: var(--zenith-navy); color: #fff; }
  .zenith-tg__cta--light { background: #f1f5f9; color: var(--zenith-ink); }
  .zenith-tg__cta-eye {
    font-size: 9px; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.18em;
    color: var(--zenith-lime);
  }
  .zenith-tg__cta-eye--blue { color: var(--zenith-electric); }
  .zenith-tg__cta-body { margin-top: 0.35rem; font-size: 13px; }
  .zenith-tg__cta-link {
