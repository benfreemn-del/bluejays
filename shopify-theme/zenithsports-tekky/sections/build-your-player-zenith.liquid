{% comment %}
  Build Your Player — full interactive 5-step lead-gen quiz.

  Ports the Next.js /clients/zenith-sports/build-your-player page to
  vanilla JS inside a Shopify section. Same flow, same plan generator
  logic (deterministic — direct port from training-plan.ts).

  Steps:
    1. Role (parent / player / coach)
    2. Builder (age slider + height slider + skill level +
       current weekly hours + EXTRA TEKKY sessions/week they'll commit
       to) with a LIVE A/B development snapshot that updates as the
       sliders move — Scenario A (typical player who skips the extra
       work) vs Scenario B (this player + committed sessions), and the
       touch GAP between them. Each committed 10-15 min session converts
       to level-scaled deliberate touches (~100 at beginner → ~150 at
       elite). The commit slider pre-fills with our recommendation and
       becomes the player's own number once they drag it.
    3. Goals (multi-select up to 3)
    4. Identity (first name, email, phone, optional sms consent)
    5. Plan reveal — auto-submits to Shopify customer form with tag
       'build-your-player-lead' and the full builder snapshot baked
       into the customer note. Then shows the personalized plan:
       level, sessions/week × min/session, projected touches/year,
       3 recommended drills with YouTube links, recommended kit with
       TEKKY™ ball CTA, next step.

  No avatars: the builder centerpiece is the live touches snapshot, so
  the whole tool speaks the same metric language as the homepage stats
  strip and the Touches Advantage calculator (TEKKY™ Teal #00C49A).
{% endcomment %}

{%- assign ball_buy_url = "https://zenithsports.org/cart/45347164389551:1" -%}

<section class="zenith-section zenith-byp">
  <div class="zenith-container">

    {%- comment -%} ── HEADER ── {%- endcomment -%}
    <header class="zenith-byp__head">
      {% if section.settings.eyebrow != blank %}
        <p class="zenith-eyebrow" style="color: var(--zenith-lime);">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      <h1 class="zenith-byp__title">
        {{ section.settings.headline_top | escape }}
        <br />
        <span class="zenith-byp__title-accent">{{ section.settings.headline_accent | escape }}</span>
      </h1>
      {% if section.settings.subhead != blank %}
        <div class="zenith-byp__subhead">{{ section.settings.subhead }}</div>
      {% endif %}
    </header>

    {%- comment -%} ── PROGRESS BAR ── {%- endcomment -%}
    <div class="zenith-byp__progress">
      <div class="zenith-byp__progress-meta">
        <span>Step <span data-step-num>1</span> of 5</span>
        <span><span data-step-pct>20</span>%</span>
      </div>
      <div class="zenith-byp__progress-track">
        <div class="zenith-byp__progress-fill" data-progress-fill></div>
      </div>
    </div>

    {%- comment -%} ── STEPS ── {%- endcomment -%}
    <div class="zenith-byp__pane">

      {%- comment -%} STEP 1 · ROLE {%- endcomment -%}
      <div class="zenith-byp__step" data-step="role">
        <p class="zenith-byp__qnum">Question 1 of 5</p>
        <h2 class="zenith-byp__qtitle">Who is this for?</h2>
        <p class="zenith-byp__qbody">We'll tune your plan for who's actually doing the training.</p>
        <div class="zenith-byp__roles">
          <button type="button" class="zenith-byp__role" data-role="parent">
            <span class="zenith-byp__role-emoji">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="6" r="3"/><path d="M2.5 21v-1a5.5 5.5 0 0 1 11 0v1"/><circle cx="17.5" cy="9.5" r="2.2"/><path d="M14.8 21v-.5a3.4 3.4 0 0 1 6.7 0v.5"/></svg>
            </span>
            <span class="zenith-byp__role-label">Parent of a player</span>
            <span class="zenith-byp__role-note">You'll guide the routine and get the plan</span>
          </button>
          <button type="button" class="zenith-byp__role" data-role="player">
            <span class="zenith-byp__role-emoji">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><path d="M12 7.3l3.4 2.5-1.3 4H9.9l-1.3-4 3.4-2.5z"/><path d="M12 7.3V3.6"/><path d="M15.4 9.8l3.4-1.2"/><path d="M14.1 13.8l2.2 3"/><path d="M9.9 13.8l-2.2 3"/><path d="M8.6 9.8 5.2 8.6"/></svg>
            </span>
            <span class="zenith-byp__role-label">I'm the player</span>
            <span class="zenith-byp__role-note">You'll run the routine yourself</span>
          </button>
          <button type="button" class="zenith-byp__role" data-role="coach">
            <span class="zenith-byp__role-emoji">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4V3a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v1"/><path d="M9 10h6"/><path d="M9 14h6"/><path d="M9 18h4"/></svg>
            </span>
            <span class="zenith-byp__role-label">Coach / trainer</span>
            <span class="zenith-byp__role-note">For your roster — we'll match a team plan</span>
          </button>
        </div>
      </div>

      {%- comment -%} STEP 2 · BUILDER {%- endcomment -%}
      <div class="zenith-byp__step" data-step="builder" hidden>
        <p class="zenith-byp__qnum">Question 2 of 5</p>
        <h2 class="zenith-byp__qtitle">Tell us about <span data-builder-subject>the player</span>.</h2>
        <p class="zenith-byp__qbody">Drag the sliders — watch the plan build in real time.</p>

        <div class="zenith-byp__builder-grid">
          <div class="zenith-byp__builder-controls">
            <div class="zenith-byp__slider">
              <div class="zenith-byp__slider-head">
                <span class="zenith-byp__field-label">Age</span>
                <span class="zenith-byp__slider-val"><span data-age-val>12</span> <small>years</small></span>
              </div>
              <input type="range" min="5" max="35" step="1" value="12" data-input="age" aria-label="Age" />
              <div class="zenith-byp__slider-marks"><span>5</span><span>15</span><span>25</span><span>35</span></div>
            </div>

            <div class="zenith-byp__slider">
              <div class="zenith-byp__slider-head">
                <span class="zenith-byp__field-label">Height</span>
                <span class="zenith-byp__slider-val"><span data-height-ft>4</span>' <span data-height-in>8</span>"</span>
              </div>
              <input type="range" min="36" max="78" step="1" value="56" data-input="height" aria-label="Height in inches" />
              <div class="zenith-byp__slider-marks"><span>3'</span><span>4'6"</span><span>5'6"</span><span>6'6"</span></div>
            </div>

            <div class="zenith-byp__slider">
              <div class="zenith-byp__slider-head">
                <span class="zenith-byp__field-label">Skill level</span>
                <span class="zenith-byp__slider-val" data-skill-label>Recreational</span>
              </div>
              <input type="range" min="1" max="5" step="1" value="2" data-input="skill" aria-label="Skill level" />
              <div class="zenith-byp__slider-marks"><span>Beginner</span><span>Rec</span><span>Travel</span><span>ECNL</span><span>Elite</span></div>
            </div>

            <div class="zenith-byp__slider">
              <div class="zenith-byp__slider-head">
                <span class="zenith-byp__field-label">Current training hours / week</span>
                <span class="zenith-byp__slider-val"><span data-hours-val>2</span> <small>hrs</small></span>
              </div>
              <input type="range" min="0" max="10" step="1" value="2" data-input="hours" aria-label="Current weekly training hours" />
              <div class="zenith-byp__slider-marks"><span>0</span><span>3</span><span>6</span><span>10+</span></div>
            </div>

            <div class="zenith-byp__slider zenith-byp__slider--commit">
              <div class="zenith-byp__slider-head">
                <span class="zenith-byp__field-label">Extra TEKKY™ sessions / week they'll commit to</span>
                <span class="zenith-byp__slider-val"><span data-commit-val>3</span> <small>&times; / wk</small></span>
              </div>
              <input type="range" min="0" max="7" step="1" value="3" data-input="commit" aria-label="Extra TEKKY sessions per week you will commit to" />
              <div class="zenith-byp__slider-marks"><span>0</span><span>2</span><span>4</span><span>7</span></div>
              <p class="zenith-byp__slider-note">Each session is just 10–15 min on the TEKKY™. This is the work a typical player skips — and the reason the gap below opens up.</p>
            </div>
          </div><!-- /builder-controls -->

          <div class="zenith-byp__snapshot" aria-live="polite">
            <span class="zenith-byp__snap-eye">Live snapshot · updates as you slide</span>

            <div class="zenith-byp__snap-scns">
              <div class="zenith-byp__snap-scn zenith-byp__snap-scn--a">
                <span class="zenith-byp__snap-scn-label">Typical player · skips the extra work</span>
                <span class="zenith-byp__snap-scn-val" data-snap-a>26,250</span>
                <span class="zenith-byp__snap-scn-unit">deliberate touches / yr</span>
              </div>
              <div class="zenith-byp__snap-scn zenith-byp__snap-scn--b">
                <span class="zenith-byp__snap-scn-label">Your player · <span data-snap-commit>3</span>&times; TEKKY&trade; / wk</span>
                <span class="zenith-byp__snap-scn-val" data-snap-b>82,500</span>
                <span class="zenith-byp__snap-scn-unit">deliberate touches / yr</span>
              </div>
            </div>

            <div class="zenith-byp__snap-gap">
              <span class="zenith-byp__snap-gap-num" data-snap-gap>+56,250</span>
              <span class="zenith-byp__snap-gap-txt">more touches a year — <strong><span data-snap-mult>3.1&times;</span></strong> the reps of a player who doesn't put in the extra work</span>
            </div>

            <div class="zenith-byp__snap-bar"><div class="zenith-byp__snap-bar-fill" data-snap-bar style="width:59%"></div></div>
            <p class="zenith-byp__snap-plan">
              <strong data-preview-level>Foundation</strong> plan · <span data-preview-sessions>3</span>&times;/week &times; <span data-preview-minutes>10</span> min · <span data-preview-tier>Warm Up</span> tier
            </p>
          </div>
        </div><!-- /builder-grid -->
      </div>

      {%- comment -%} STEP 3 · GOALS {%- endcomment -%}
      <div class="zenith-byp__step" data-step="goals" hidden>
        <p class="zenith-byp__qnum">Question 3 of 5</p>
        <h2 class="zenith-byp__qtitle">What are you after?</h2>
        <p class="zenith-byp__qbody">Pick up to 3. We use these to handpick the drills that move the needle for your player.</p>
        <p class="zenith-byp__qcount"><span data-count-goals>0</span> / 3 selected</p>
        <div class="zenith-byp__goals">
          <button type="button" class="zenith-byp__goal" data-goal="first-touch">
            <span class="zenith-byp__goal-check">✓</span>
            <span class="zenith-byp__goal-emoji"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><line x1="12" y1="2.5" x2="12" y2="6"/><line x1="12" y1="18" x2="12" y2="21.5"/><line x1="2.5" y1="12" x2="6" y2="12"/><line x1="18" y1="12" x2="21.5" y2="12"/><circle cx="12" cy="12" r="2.4"/></svg></span>
            <span class="zenith-byp__goal-label">Sharper first touch</span>
          </button>
          <button type="button" class="zenith-byp__goal" data-goal="tryouts">
            <span class="zenith-byp__goal-check">✓</span>
            <span class="zenith-byp__goal-emoji"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="5" width="16" height="16" rx="2"/><path d="M4 9.5h16"/><path d="M8 3v4"/><path d="M16 3v4"/><path d="M9.3 14.8l1.8 1.8 3.6-3.6"/></svg></span>
            <span class="zenith-byp__goal-label">Prepare for tryouts</span>
          </button>
          <button type="button" class="zenith-byp__goal" data-goal="confidence">
            <span class="zenith-byp__goal-check">✓</span>
            <span class="zenith-byp__goal-emoji"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8Z"/></svg></span>
            <span class="zenith-byp__goal-label">More confidence in 1v1s</span>
          </button>
          <button type="button" class="zenith-byp__goal" data-goal="tactics">
            <span class="zenith-byp__goal-check">✓</span>
            <span class="zenith-byp__goal-emoji"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg></span>
            <span class="zenith-byp__goal-label">Move from rec to club</span>
          </button>
          <button type="button" class="zenith-byp__goal" data-goal="ecnl">
            <span class="zenith-byp__goal-check">✓</span>
            <span class="zenith-byp__goal-emoji"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg></span>
            <span class="zenith-byp__goal-label">Get noticed by ECNL/MLS Next</span>
          </button>
          <button type="button" class="zenith-byp__goal" data-goal="fitness">
            <span class="zenith-byp__goal-check">✓</span>
            <span class="zenith-byp__goal-emoji"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="8" width="3.5" height="8" rx="1"/><rect x="18" y="8" width="3.5" height="8" rx="1"/><line x1="6" y1="12" x2="18" y2="12"/></svg></span>
            <span class="zenith-byp__goal-label">Build strength + technique</span>
          </button>
          <button type="button" class="zenith-byp__goal" data-goal="fun">
            <span class="zenith-byp__goal-check">✓</span>
            <span class="zenith-byp__goal-emoji"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.29 1.51 4.04 3 5.5l7 7Z"/></svg></span>
            <span class="zenith-byp__goal-label">Fall back in love with the ball</span>
          </button>
        </div>
      </div>

      {%- comment -%} STEP 4 · IDENTITY {%- endcomment -%}
      <div class="zenith-byp__step" data-step="identity" hidden>
        <p class="zenith-byp__qnum">Last step · then your plan</p>
        <h2 class="zenith-byp__qtitle">Where should we send your plan?</h2>
        <p class="zenith-byp__qbody">Your plan + drill links land in your inbox immediately. We don't share your info, and you can unsubscribe with one click.</p>

        <div class="zenith-byp__form">
          <label class="zenith-byp__field">
            <span>First name *</span>
            <input type="text" data-input="firstName" placeholder="Sarah" autocomplete="given-name" />
          </label>
          <label class="zenith-byp__field">
            <span>Email *</span>
            <input type="email" data-input="email" placeholder="sarah@example.com" autocomplete="email" />
          </label>
          <label class="zenith-byp__field">
            <span>Phone (optional)</span>
            <input type="tel" data-input="phone" placeholder="(555) 123-4567" autocomplete="tel" />
          </label>

          <label class="zenith-byp__consent">
            <input type="checkbox" data-input="drill-email" />
            <span>
              <strong>Email me the Drill of the Month</strong> — one new technical drill + coaching tip in your inbox each month.
              <small>Optional. Unsubscribe anytime.</small>
            </span>
          </label>
        </div>
      </div>

      {%- comment -%} STEP 5 · PLAN REVEAL (renders dynamically + auto-submits) {%- endcomment -%}
      <div class="zenith-byp__step" data-step="plan" hidden>
        <div class="zenith-byp__plan" data-plan-out>
          {%- comment -%} Dynamically populated by JS on entry to this step {%- endcomment -%}
        </div>

        {%- comment -%}
          Hidden Shopify customer form. JS fills the inputs on plan-reveal
          entry and submits programmatically. Submission lands in Shopify
          Admin -> Customers tagged 'build-your-player-lead' with the full
          builder snapshot in the Note field.
        {%- endcomment -%}
        {% form 'customer', class: 'zenith-byp__hidden-form' %}
          <input type="hidden" name="contact[tags]" value="build-your-player-lead, zenith-tekky" />
          <input type="hidden" name="contact[accepts_marketing]" value="1" />
          <input type="hidden" name="contact[first_name]" data-hidden="firstName" value="" />
          <input type="hidden" name="contact[email]" data-hidden="email" value="" />
          <input type="hidden" name="contact[phone]" data-hidden="phone" value="" />
          <input type="hidden" name="contact[note]" data-hidden="note" value="" />
          <button type="submit" data-form-submit hidden>Submit</button>
          {% if form.posted_successfully? %}
            <p class="zenith-byp__sent">✓ Plan saved — check your inbox for the full breakdown.</p>
          {% endif %}
          {%- if form.errors -%}
            <p class="zenith-byp__sent zenith-byp__sent--err">{{ form.errors | default_errors }}</p>
          {%- endif -%}
        {% endform %}
      </div>

      {%- comment -%} ── NAV ── {%- endcomment -%}
      <div class="zenith-byp__nav" data-nav>
        <button type="button" class="zenith-byp__back" data-back hidden>← Back</button>
        <button type="button" class="zenith-btn zenith-btn--primary zenith-byp__next" data-next disabled>
          Next →
        </button>
      </div>

    </div>
  </div>
</section>

<style>
  .zenith-byp {
    background: linear-gradient(180deg, var(--zenith-navy-deep) 0%, var(--zenith-navy) 100%);
    color: #fff;
    padding: 3rem 0 5rem;
  }
  @media (min-width: 768px) { .zenith-byp { padding: 5rem 0 7rem; } }

  .zenith-byp__head { text-align: center; max-width: 48rem; margin: 0 auto 2rem; }
  .zenith-byp__title {
    font-size: clamp(2rem, 5.5vw, 4rem);
    font-weight: 900; line-height: 1;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    color: #fff;
    margin: 0.75rem 0 1.25rem;
  }
  .zenith-byp__title-accent { color: var(--zenith-lime); }
  .zenith-byp__subhead { color: rgba(255,255,255,0.82); font-size: 1.0625rem; line-height: 1.65; }
  .zenith-byp__subhead p { margin: 0; }

  .zenith-byp__progress { max-width: 56rem; margin: 0 auto 2.5rem; }
  .zenith-byp__progress-meta {
    display: flex; justify-content: space-between;
    font-size: 11px; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.18em;
    color: rgba(255,255,255,0.72);
    margin-bottom: 0.45rem;
  }
  .zenith-byp__progress-track {
    height: 6px; border-radius: 999px;
    background: rgba(255,255,255,0.1);
    overflow: hidden;
  }
  .zenith-byp__progress-fill {
    height: 100%; width: 20%;
    background: var(--zenith-lime);
    border-radius: 999px;
    transition: width 0.4s;
  }

  .zenith-byp__pane { max-width: 48rem; margin: 0 auto; }
  .zenith-byp__step[hidden] { display: none; }
  .zenith-byp__qnum {
    font-size: 11px; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.32em;
    color: var(--zenith-lime);
    margin: 0 0 0.65rem;
  }
  .zenith-byp__qtitle {
    font-size: clamp(1.5rem, 4vw, 2.75rem);
    font-weight: 900; line-height: 1.05;
    color: #fff;
    margin: 0 0 0.75rem;
  }
  .zenith-byp__qbody {
    font-size: 1.0625rem;
    color: rgba(255,255,255,0.78);
    line-height: 1.6;
    margin: 0 0 1.5rem;
  }
  .zenith-byp__qcount {
    font-size: 12px; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.16em;
    color: rgba(255,255,255,0.62);
    margin: 0 0 1.5rem;
  }

  /* Role cards */
  .zenith-byp__roles { display: grid; gap: 0.65rem; grid-template-columns: 1fr; }
  @media (min-width: 768px) { .zenith-byp__roles { grid-template-columns: repeat(3, 1fr); } }
  .zenith-byp__role {
    display: flex; flex-direction: column; gap: 0.4rem;
    background: rgba(255,255,255,0.05);
    border: 2px solid rgba(255,255,255,0.1);
    border-radius: 16px;
    padding: 1.5rem;
    text-align: center;
    color: #fff;
    cursor: pointer;
    transition: transform 0.15s, border-color 0.15s, background 0.15s;
  }
  .zenith-byp__role:hover { border-color: rgba(0,196,154,0.4); transform: scale(1.02); }
  .zenith-byp__role--active {
    background: var(--zenith-lime);
    border-color: var(--zenith-lime);
    color: var(--zenith-navy-deep);
  }
  .zenith-byp__role-emoji {
    display: inline-flex; justify-content: center; align-items: center;
    color: var(--zenith-lime);
    margin-bottom: 0.35rem;
  }
  .zenith-byp__role-emoji svg { width: 46px; height: 46px; }
  .zenith-byp__role--active .zenith-byp__role-emoji { color: var(--zenith-navy-deep); }
  .zenith-byp__role-label { font-size: 1.15rem; font-weight: 800; }
  .zenith-byp__role-note { font-size: 13px; opacity: 0.75; }
  .zenith-byp__role--active .zenith-byp__role-note { color: rgba(15,23,42,0.7); opacity: 1; }

  /* Builder fields */
