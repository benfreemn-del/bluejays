<script>
  (function () {
    var root = document.querySelector('.zenith-byp');
    if (!root) return;

    var BALL_BUY_URL = "{{ ball_buy_url }}";
    var STEPS = ['role', 'builder', 'goals', 'identity', 'plan'];

    var state = {
      step: 'role',
      role: null,
      firstName: '',
      email: '',
      phone: '',
      age: 12,
      heightInches: 56,
      skillLevel: 2,
      currentWeeklyHours: 2,
      committedSessions: 3,   // extra TEKKY sessions/week the player commits to
      committedTouched: false, // once the user drags the commit slider, stop auto-syncing to the prescription
      goals: [],
      drillEmail: false
    };

    function $(s, c) { return (c || root).querySelector(s); }
    function $$(s, c) { return Array.prototype.slice.call((c || root).querySelectorAll(s)); }

    // ── TOUCHES MODEL ──────────────────────────────────────────────────────
    // Baseline: a traditional-only player banks ~26,250 deliberate touches a
    // year from team training alone. Each extra 10-15 min TEKKY™ session adds
    // deliberate touches that scale with player level — a beginner converts a
    // session into ~100 quality touches, an elite player ~150 (sharper focus,
    // faster reps, cleaner technique). 50 training weeks a year.
    var BASELINE_TOUCHES = 26250;
    var TRAINING_WEEKS = 50;
    function touchesPerSession(level) {
      var lv = Math.max(1, Math.min(5, level || 1));
      return Math.round(100 + (lv - 1) * 12.5); // 100 / 113 / 125 / 138 / 150
    }
    // Scenario A = no extra work; Scenario B = baseline + committed sessions.
    function scenarioTouches(level, committedSessions) {
      var added = Math.max(0, committedSessions || 0) * TRAINING_WEEKS * touchesPerSession(level);
      return { baseline: BASELINE_TOUCHES, added: added, total: BASELINE_TOUCHES + added };
    }

    // Sessions/week we RECOMMEND for a given player (the commit slider's default).
    function prescribedSessions(s) {
      var sessions;
      if (s.skillLevel <= 2 || s.age <= 8) sessions = 3;
      else if (s.skillLevel === 3) sessions = 4;
      else if (s.skillLevel === 4) sessions = 5;
      else sessions = 6;
      if (s.currentWeeklyHours >= 5 && sessions < 6) sessions += 1;
      return Math.min(7, sessions);
    }

    // ── PLAN GENERATOR (port of training-plan.ts) ─────────────────────────
    function generatePlan(s) {
      var level, focusTier, minutesPerSession;
      if (s.skillLevel <= 2 || s.age <= 8) {
        level = 'Foundation'; focusTier = 'Warm Up'; minutesPerSession = 10;
      } else if (s.skillLevel === 3) {
        level = 'Builder'; focusTier = 'Beginner'; minutesPerSession = 15;
      } else if (s.skillLevel === 4) {
        level = 'Accelerator'; focusTier = 'Intermediate'; minutesPerSession = 20;
      } else {
        level = 'Elite'; focusTier = 'Intermediate'; minutesPerSession = 25;
      }
      // Effective sessions = what the player commits to (falls back to the
      // recommendation when the commit slider hasn't been set yet).
      var weeklySessions = (s.committedSessions != null)
        ? Math.max(0, Math.min(7, s.committedSessions))
        : prescribedSessions(s);

      var drills = pickDrillsForTier(focusTier, s.goals, s.age);

      var kit;
      if (level === 'Foundation') {
        kit = { items: ['The TEKKY™ Ball'], label: 'Starter — just the ball', priceUsd: 59.95 };
      } else if (level === 'Builder') {
        kit = { items: ['The TEKKY™ Ball', 'TEKKY™ Grip Socks'], label: 'Builder kit — ball + grip socks for stable footwork', priceUsd: 74.95 };
      } else {
        kit = { items: ['The TEKKY™ Ball', 'TEKKY™ Grip Socks', 'High Performance TEKKY™ Training Tee'], label: 'Elite kit — ball + grip socks + training tee', priceUsd: 92.45 };
      }

      var nextStep = s.role === 'coach'
        ? "Book a free 30-minute club demo — we'll walk you through the curriculum and ship a few balls to your roster on us."
        : s.role === 'parent'
          ? "Get the TEKKY™ and start the 14-day Foundation routine. By week 2, the difference will be visible."
          : "Grab the TEKKY™ and start the cadence above today. Tag #TEKKYTouch in your training reels — we feature one player a week.";

      var totalWeekly = weeklySessions * minutesPerSession;
      var audience = s.role === 'coach'
        ? 'For your roster, this means ' + weeklySessions + ' short technical blocks a week — drop them into your existing practice as warm-up replacements.'
        : s.role === 'parent'
          ? 'For ' + (s.firstName || 'your player') + ', that\'s ' + minutesPerSession + ' minutes a day — a 10-min driveway routine before homework, ' + weeklySessions + ' times a week.'
          : 'That\'s ' + minutesPerSession + ' minutes ' + weeklySessions + ' times a week. Doable before practice, after school, or during your warm-up.';
      var pitch = 'Your ' + level + ' plan: ' + weeklySessions + ' sessions a week × ' + minutesPerSession + ' minutes — ' + totalWeekly + ' total minutes of focused TEKKY™ work. ' + audience + ' You\'ll feel the change in your touch within 14 days, and your coach will see it before week 4.';

      return {
        level: level, focusTier: focusTier,
        weeklySessions: weeklySessions,
        prescribedSessions: prescribedSessions(s),
        minutesPerSession: minutesPerSession,
        touchesPerSession: touchesPerSession(s.skillLevel),
        scenario: scenarioTouches(s.skillLevel, weeklySessions),
        recommendedDrills: drills, recommendedKit: kit, nextStep: nextStep, pitch: pitch
      };
    }

    function pickDrillsForTier(tier, goals, age) {
      if (tier === 'Warm Up') {
        return [
          { id: 'bX-HMzizdxU', name: 'Instep Touch', reason: age <= 8 ? 'First touch — wakes up the ankle and trains rhythm.' : 'Foundation rep — re-tunes the laces-to-ball relationship.' },
          { id: 'qXGWT_-_yF4', name: 'Laces Gather and Pass', reason: 'Soft cushion + redirect. The bedrock first-touch move.' },
          { id: 'G8aa_34JpFg', name: 'Sole Trap, Instep Pass', reason: 'Sole control + clean redirect — under-trained at U10 in U.S. soccer.' }
        ];
      }
      if (tier === 'Beginner') {
        var wantsFirstTouch = goals.indexOf('first-touch') >= 0;
        var wants1v1 = goals.indexOf('confidence') >= 0;
        return [
          { id: wantsFirstTouch ? 'n4625BwqiU0' : 'l40Cq1RJ_QI', name: wantsFirstTouch ? 'Push Pull' : 'La Croqueta', reason: wantsFirstTouch ? 'Sole-of-foot rhythm. The fundamental beat of every pro\'s close control.' : 'Iniesta\'s signature lateral shift. Builds the move that breaks tight pressure.' },
          { id: 'ojviCQ0mrsY', name: 'V-Cut', reason: wants1v1 ? 'Change-of-direction in one touch — exact shape every winger uses to beat a defender 1v1.' : 'Single-touch direction change. Foundation for everything tactical that comes next.' },
          { id: 'Kaj6ymLWsB8', name: 'Scissors · Outside Push', reason: 'Body-feint into outside-foot exit. Trains deception + acceleration in one rep.' }
        ];
      }
      var wantsECNL = goals.indexOf('ecnl') >= 0;
      var wantsTactics = goals.indexOf('tactics') >= 0;
      return [
        { id: 'aLWVJfbAn9I', name: 'Tap Tap Drag · La Croqueta · Drag', reason: wantsECNL ? 'Six-touch combo. The kind of close-quarter solving that turns U13 academy players into U15 first-team prospects.' : 'Stacked combo move — when you own this, you own the regulation ball easily.' },
        { id: '9frnJdNJW9o', name: 'Roll · Stepover [The Jay Jay]', reason: 'Pure deception under tight space. A signature trick that translates to game day.' },
        { id: 'fydguVA6Fzw', name: 'Touch In · Scissors · Touch Out', reason: wantsTactics ? 'Closest move in the library to a real-game 1v1. Builds the read needed in academy-level pressure.' : 'Three-touch deception sequence. Real-game-pace drilling.' }
      ];
    }

    function skillLabel(n) {
      return ['', 'Beginner', 'Recreational', 'Travel / club', 'ECNL / MLS Next', 'Elite'][n] || 'Recreational';
    }


    function canAdvance() {
      if (state.step === 'role') return state.role !== null;
      if (state.step === 'builder') return true;
      if (state.step === 'goals') return state.goals.length >= 1;
      if (state.step === 'identity') return state.firstName.trim().length >= 2 && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(state.email);
      return false;
    }

    function renderStep() {
      $$('.zenith-byp__step').forEach(function (el) {
        el.hidden = el.getAttribute('data-step') !== state.step;
      });
      var idx = STEPS.indexOf(state.step);
      $('[data-step-num]').textContent = idx + 1;
      var pct = Math.round(((idx + 1) / 5) * 100);
      $('[data-step-pct]').textContent = pct;
      $('[data-progress-fill]').style.width = pct + '%';

      var backBtn = $('[data-back]'); if (backBtn) backBtn.hidden = idx === 0;
      var nav = $('[data-nav]'); if (nav) nav.hidden = state.step === 'plan';
      var nextBtn = $('[data-next]');
      if (nextBtn) {
        nextBtn.disabled = !canAdvance();
        nextBtn.textContent = state.step === 'identity' ? 'Show my plan →' : 'Next →';
      }

      if (state.step === 'plan') renderPlan();
    }

    function renderBuilderLive() {
      $('[data-age-val]').textContent = state.age;
      var ft = Math.floor(state.heightInches / 12);
      var inch = state.heightInches % 12;
      $('[data-height-ft]').textContent = ft;
      $('[data-height-in]').textContent = inch;
      $('[data-skill-label]').textContent = skillLabel(state.skillLevel);
      $('[data-hours-val]').textContent = state.currentWeeklyHours;

      // Auto-fill the commit slider with our recommendation until the user
      // drags it themselves — then it's their number and we leave it alone.
      if (!state.committedTouched) {
        var rec = prescribedSessions({ age: state.age, skillLevel: state.skillLevel, currentWeeklyHours: state.currentWeeklyHours });
        state.committedSessions = rec;
        var commitIn = $('[data-input="commit"]');
        if (commitIn) commitIn.value = rec;
      }
      $('[data-commit-val]').textContent = state.committedSessions;

      // Live development snapshot — Scenario A (typical player, no extra work)
      // vs Scenario B (this player + the committed TEKKY™ sessions). Each
      // session converts to level-scaled deliberate touches (100→150).
      var sp = generatePlan({ role: state.role || 'parent', firstName: state.firstName, age: state.age, heightInches: state.heightInches, skillLevel: state.skillLevel, currentWeeklyHours: state.currentWeeklyHours, committedSessions: state.committedSessions, goals: state.goals });
      var scn = sp.scenario;
      var mult = scn.total / scn.baseline;
      // Bar maxes out at the strongest realistic commitment (7×/wk at elite yield).
      var barMax = BASELINE_TOUCHES + 7 * TRAINING_WEEKS * touchesPerSession(5);

      var snapA = $('[data-snap-a]'); if (snapA) snapA.textContent = scn.baseline.toLocaleString();
      var snapB = $('[data-snap-b]'); if (snapB) snapB.textContent = scn.total.toLocaleString();
      var snapCommit = $('[data-snap-commit]'); if (snapCommit) snapCommit.textContent = state.committedSessions;
      var snapGap = $('[data-snap-gap]'); if (snapGap) snapGap.textContent = (scn.added > 0 ? '+' : '') + scn.added.toLocaleString();
      var snapMult = $('[data-snap-mult]');
      if (snapMult) snapMult.innerHTML = (mult >= 10 ? mult.toFixed(0) : mult.toFixed(1)) + '&times;';
      var snapBar = $('[data-snap-bar]');
      if (snapBar) snapBar.style.width = Math.min(100, Math.round((scn.total / barMax) * 100)) + '%';

      var pLevel = $('[data-preview-level]'); if (pLevel) pLevel.textContent = sp.level;
      var pSessions = $('[data-preview-sessions]'); if (pSessions) pSessions.textContent = sp.weeklySessions;
      var pMinutes = $('[data-preview-minutes]'); if (pMinutes) pMinutes.textContent = sp.minutesPerSession;
      var pTier = $('[data-preview-tier]'); if (pTier) pTier.textContent = sp.focusTier;

      // Pronoun in question title
      var subject = $('[data-builder-subject]');
      if (subject) {
        subject.textContent = state.role === 'player' ? 'yourself' : state.role === 'coach' ? 'a typical player' : 'your player';
      }
    }

    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }

    function renderPlan() {
      var p = generatePlan({ role: state.role || 'parent', firstName: state.firstName, age: state.age, heightInches: state.heightInches, skillLevel: state.skillLevel, currentWeeklyHours: state.currentWeeklyHours, committedSessions: state.committedSessions, goals: state.goals });
      var out = $('[data-plan-out]');
      if (!out) return;

      var drillHtml = p.recommendedDrills.map(function (d, i) {
        return '<div class="zenith-byp__drill">'
          + '<div class="zenith-byp__drill-num">' + String(i + 1).padStart(2, '0') + '</div>'
          + '<div class="zenith-byp__drill-body">'
          +   '<h4 class="zenith-byp__drill-name">' + escapeHtml(d.name) + '</h4>'
          +   '<p class="zenith-byp__drill-reason">' + escapeHtml(d.reason) + '</p>'
          + '</div>'
          + '<a href="https://www.youtube.com/watch?v=' + encodeURIComponent(d.id) + '" target="_blank" rel="noopener noreferrer" class="zenith-byp__drill-link">Watch ↗</a>'
          + '</div>';
      }).join('');

      var kitItemsHtml = p.recommendedKit.items.map(function (item) {
        return '<li>' + escapeHtml(item) + '</li>';
      }).join('');

      // Touches math — Scenario A vs Scenario B (same model as the live snapshot)
      var planTotal = p.scenario.total;
      var planGap = p.scenario.added;
      var planMult = planTotal / p.scenario.baseline;
      var planMultStr = (planMult >= 10 ? planMult.toFixed(0) : planMult.toFixed(1));

      out.innerHTML = ''
        + '<div class="zenith-byp__plan-hero">'
        +   '<div class="zenith-byp__plan-eye">Your personalized plan</div>'
        +   '<h2 class="zenith-byp__plan-level">' + escapeHtml(p.level) + '</h2>'
        +   '<div class="zenith-byp__plan-meta">'
        +     '<div class="zenith-byp__plan-meta-item"><span class="zenith-byp__plan-meta-key">Sessions / week</span><span class="zenith-byp__plan-meta-val">' + p.weeklySessions + '</span></div>'
        +     '<div class="zenith-byp__plan-meta-item"><span class="zenith-byp__plan-meta-key">Minutes / session</span><span class="zenith-byp__plan-meta-val">' + p.minutesPerSession + '</span></div>'
        +     '<div class="zenith-byp__plan-meta-item"><span class="zenith-byp__plan-meta-key">Drill tier</span><span class="zenith-byp__plan-meta-val">' + escapeHtml(p.focusTier) + '</span></div>'
        +   '</div>'
        +   '<div class="zenith-byp__plan-touches">Committing to <strong>' + p.weeklySessions + ' extra TEKKY™ session' + (p.weeklySessions === 1 ? '' : 's') + '/week</strong> banks <strong>' + planTotal.toLocaleString() + '</strong> touches a year — <strong>+' + planGap.toLocaleString() + '</strong> more than a player who skips the extra work (<strong>' + planMultStr + '×</strong> the reps).</div>'
        +   '<p class="zenith-byp__plan-pitch">' + escapeHtml(p.pitch) + '</p>'
        + '</div>'
        + '<div class="zenith-byp__plan-block">'
        +   '<p class="zenith-byp__plan-block-head">Your 3 starter drills</p>'
        +   '<h3 class="zenith-byp__plan-block-title">Hand-picked for your goals.</h3>'
        +   '<div class="zenith-byp__drills">' + drillHtml + '</div>'
        + '</div>'
        + '<div class="zenith-byp__plan-block">'
        +   '<p class="zenith-byp__plan-block-head">Recommended kit</p>'
        +   '<h3 class="zenith-byp__plan-block-title">' + escapeHtml(p.recommendedKit.label) + '</h3>'
        +   '<div class="zenith-byp__kit">'
        +     '<div>'
        +       '<ul class="zenith-byp__kit-items">' + kitItemsHtml + '</ul>'
        +     '</div>'
        +     '<div class="zenith-byp__kit-price">$' + p.recommendedKit.priceUsd.toFixed(2) + '</div>'
        +   '</div>'
        +   '<div class="zenith-byp__plan-cta">'
        +     '<a href="' + BALL_BUY_URL + '" class="zenith-btn zenith-btn--primary">Buy the TEKKY™ · $59.95</a>'
        +     '<a href="/collections/all" class="zenith-btn zenith-btn--ghost">Shop the full kit →</a>'
        +   '</div>'
        + '</div>'
        + '<div class="zenith-byp__plan-block">'
        +   '<p class="zenith-byp__plan-block-head">Your next step</p>'
        +   '<p class="zenith-byp__plan-pitch">' + escapeHtml(p.nextStep) + '</p>'
        + '</div>';

      // Fill the hidden Shopify customer form + submit it (once).
      if (!state._submitted) {
        var fn = root.querySelector('[data-hidden="firstName"]'); if (fn) fn.value = state.firstName;
        var em = root.querySelector('[data-hidden="email"]'); if (em) em.value = state.email;
        var ph = root.querySelector('[data-hidden="phone"]'); if (ph) ph.value = state.phone;
        var nt = root.querySelector('[data-hidden="note"]');
        if (nt) {
          nt.value = [
            'Build Your Player quiz submission',
            'Role: ' + (state.role || '—'),
            'Age: ' + state.age,
            'Height: ' + Math.floor(state.heightInches / 12) + '\' ' + (state.heightInches % 12) + '"',
            'Skill level: ' + skillLabel(state.skillLevel),
            'Current weekly hours: ' + state.currentWeeklyHours,
            'Committed TEKKY sessions/wk: ' + state.committedSessions + ' (recommended ' + p.prescribedSessions + ')',
            'Projected touches/yr: ' + p.scenario.total.toLocaleString() + ' (+' + p.scenario.added.toLocaleString() + ' vs typical player)',
            'Goals: ' + state.goals.join(', '),
            'Generated plan: ' + p.level + ' · ' + p.weeklySessions + 'x/wk · ' + p.minutesPerSession + ' min · ' + p.focusTier,
            'Kit fit: ' + p.recommendedKit.label + ' ($' + p.recommendedKit.priceUsd.toFixed(2) + ')',
            'Drill-of-Month email: ' + (state.drillEmail ? 'yes' : 'no')
          ].join('\n');
        }
        state._submitted = true;
        var submitBtn = root.querySelector('[data-form-submit]');
        if (submitBtn) submitBtn.click();
      }
    }

    // ── INTERACTIONS ───────────────────────────────────────────────────────
    $$('[data-role]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        state.role = btn.getAttribute('data-role');
        $$('[data-role]').forEach(function (b) {
          b.classList.toggle('zenith-byp__role--active', b === btn);
        });
        renderStep();
      });
    });

    var ageIn = $('[data-input="age"]');
    if (ageIn) ageIn.addEventListener('input', function (e) { state.age = parseInt(e.target.value, 10); renderBuilderLive(); });
    var heightIn = $('[data-input="height"]');
    if (heightIn) heightIn.addEventListener('input', function (e) { state.heightInches = parseInt(e.target.value, 10); renderBuilderLive(); });
    var skillIn = $('[data-input="skill"]');
    if (skillIn) skillIn.addEventListener('input', function (e) { state.skillLevel = parseInt(e.target.value, 10); renderBuilderLive(); });
    var hoursIn = $('[data-input="hours"]');
    if (hoursIn) hoursIn.addEventListener('input', function (e) { state.currentWeeklyHours = parseInt(e.target.value, 10); renderBuilderLive(); });
    var commitIn = $('[data-input="commit"]');
    if (commitIn) commitIn.addEventListener('input', function (e) { state.committedTouched = true; state.committedSessions = parseInt(e.target.value, 10); renderBuilderLive(); });

    $$('[data-goal]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var id = btn.getAttribute('data-goal');
        var i = state.goals.indexOf(id);
        if (i >= 0) state.goals.splice(i, 1);
        else if (state.goals.length < 3) state.goals.push(id);
        else return;
        paintGoals();
        $('[data-count-goals]').textContent = state.goals.length;
        renderStep();
      });
    });
    function paintGoals() {
      $$('[data-goal]').forEach(function (b) {
        var id = b.getAttribute('data-goal');
        var active = state.goals.indexOf(id) >= 0;
        b.classList.toggle('zenith-byp__goal--active', active);
        var atCap = !active && state.goals.length >= 3;
        b.classList.toggle('zenith-byp__goal--disabled', atCap);
        b.disabled = atCap;
      });
    }

    var fn = $('[data-input="firstName"]');
    if (fn) fn.addEventListener('input', function (e) { state.firstName = e.target.value; renderStep(); });
    var em = $('[data-input="email"]');
    if (em) em.addEventListener('input', function (e) { state.email = e.target.value; renderStep(); });
    var ph = $('[data-input="phone"]');
    if (ph) ph.addEventListener('input', function (e) { state.phone = e.target.value; });
    var drillEmail = $('[data-input="drill-email"]');
    if (drillEmail) drillEmail.addEventListener('change', function (e) { state.drillEmail = e.target.checked; });

    var nextBtn = $('[data-next]');
    if (nextBtn) nextBtn.addEventListener('click', function () {
      if (!canAdvance()) return;
      var idx = STEPS.indexOf(state.step);
      if (idx < STEPS.length - 1) {
        state.step = STEPS[idx + 1];
        renderStep();
        if (state.step === 'builder') renderBuilderLive();
        window.scrollTo({ top: root.offsetTop - 20, behavior: 'smooth' });
      }
    });
    var backBtn = $('[data-back]');
    if (backBtn) backBtn.addEventListener('click', function () {
      var idx = STEPS.indexOf(state.step);
      if (idx > 0) {
        // Allow re-entry to plan submit if user goes back then forward again
        if (state.step === 'plan') state._submitted = false;
        state.step = STEPS[idx - 1];
        renderStep();
      }
    });

    // INIT
    renderStep();
    renderBuilderLive();
  })();
</script>

{% schema %}
{
  "name": "Zenith BYP Quiz",
  "tag": "section",
  "class": "zenith-byp-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Build Your Player · Free" },
    { "type": "text", "id": "headline_top", "label": "Headline (top line)", "default": "60 seconds to a" },
    { "type": "text", "id": "headline_accent", "label": "Headline (accent line)", "default": "personalized plan." },
    { "type": "richtext", "id": "subhead", "label": "Subhead", "default": "<p>Tell us about your player — role, age, skill level, goals — and we generate a custom 4-week TEKKY™ plan plus the 3 starter drills matched to where they are now. Free.</p>" }
  ],
  "presets": [
    { "name": "Zenith BYP Quiz" }
  ]
}
{% endschema %}
