{% comment %}
  Zenith Sports / TEKKY™ footer.
  Replaces Dawn's default footer with the Zenith-branded version.

  Network-effect credit: "Built by BlueJays" -> bluejayportfolio.com
  (per CLAUDE.md Quality Rule #8 -- every site footer pulls portfolio traffic).
{% endcomment %}

<footer class="zenith-footer zenith-section">
  <div class="zenith-container">
    <div class="zenith-footer__top">

      <a href="{{ routes.root_url }}" class="zenith-footer__brand-link">
        {%- comment -%} Hardcoded to the high-quality white-lettering logo asset (same as the header), ignoring the customizer's old CDN default. {%- endcomment -%}
        <img src="{{ 'zenith-logo-white.png' | asset_url }}" alt="{{ shop.name | escape }}" width="80" height="80" loading="lazy">
        <div>
          <div class="zenith-footer__brand-name">{{ shop.name | escape }}</div>
          <div class="zenith-footer__brand-tagline">{% render 'zenith-text', text: section.settings.tagline %}</div>
        </div>
      </a>

      {% if section.settings.brand_blurb != blank %}
        <p class="zenith-footer__blurb">{{ section.settings.brand_blurb }}</p>
      {% endif %}

      <nav class="zenith-footer__nav" aria-label="Footer">
        <a href="{{ routes.root_url }}">Home</a>
        <a href="/pages/shop">Shop the TEKKY™</a>
        <a href="/pages/build-your-player">Build Your Player</a>
        <a href="/#contact">Contact</a>
      </nav>

      <div class="zenith-footer__socials">
        {% if section.settings.instagram_url != blank %}
          <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener noreferrer" class="zenith-footer__social" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
          </a>
        {% endif %}
        {% if section.settings.facebook_url != blank %}
          <a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener noreferrer" class="zenith-footer__social" aria-label="Facebook">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
        {% endif %}
        {% if section.settings.youtube_url != blank %}
          <a href="{{ section.settings.youtube_url }}" target="_blank" rel="noopener noreferrer" class="zenith-footer__social" aria-label="YouTube">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
        {% endif %}
      </div>

      {% if section.settings.contact_email != blank %}
        <a class="zenith-footer__email" href="mailto:{{ section.settings.contact_email }}">{{ section.settings.contact_email }}</a>
      {% endif %}

    </div>

    <div class="zenith-footer__trust">
      <div class="zenith-footer__trust-badges">
        <span class="zenith-footer__trust-badge">
          <svg class="zenith-trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          Secure Checkout
        </span>
        <span class="zenith-footer__trust-badge">
          <svg class="zenith-trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          Ships from the USA
        </span>
        <span class="zenith-footer__trust-badge">
          <svg class="zenith-trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><path d="M9 12l2 2 4-4"></path></svg>
          Patent Pending
        </span>
      </div>
      <div class="zenith-footer__payments" aria-label="Accepted payment methods">
        {%- for type in shop.enabled_payment_types -%}
          <span class="zenith-footer__payment">{{ type | payment_type_svg_tag: class: 'zenith-footer__payment-svg' }}</span>
        {%- else -%}
          <span class="zenith-footer__payment-text">Visa | Mastercard | Amex | Discover | Apple Pay | Google Pay | Shop Pay</span>
        {%- endfor -%}
      </div>
    </div>

    <div class="zenith-footer__bottom" style="display:flex; align-items:center; justify-content:space-between; gap:1rem; flex-wrap:wrap;">
      <div>
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}, LLC &nbsp;|&nbsp;
        TEKKY™<sup style="font-size: 0.55em; vertical-align: super;">&trade;</sup> is a trademark of Zenith Sports &nbsp;|&nbsp; Patent Pending
      </div>
      {%- comment -%} Owner backdoor — lock icon, bottom right. Opens the
        password-gated analytics backend (emails collected + per-page
        site views) on the BlueJays platform. {%- endcomment -%}
      <a href="https://bluejayportfolio.com/clients/zenith-sports/stats" target="_blank" rel="nofollow noopener" aria-label="Owner analytics" title="Owner analytics"
         style="display:inline-flex; align-items:center; opacity:0.45; transition:opacity 0.2s; color:inherit;"
         onmouseover="this.style.opacity=1" onmouseout="this.style.opacity=0.45">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
      </a>
    </div>
  </div>

  <button type="button" class="zenith-backtotop" aria-label="Back to top" data-backtotop>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 15l-6-6-6 6"/></svg>
  </button>
</footer>

<script>
  (function () {
    var btn = document.querySelector('[data-backtotop]');
    if (!btn) return;
    function onScroll() {
      var max = document.documentElement.scrollHeight - window.innerHeight;
      if (max > 0 && window.scrollY > max / 3) { btn.classList.add('is-visible'); }
      else { btn.classList.remove('is-visible'); }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    btn.addEventListener('click', function () { window.scrollTo({ top: 0, behavior: 'smooth' }); });
    onScroll();
  })();
</script>

<style>
  .zenith-footer__top {
    display: flex; flex-direction: column; align-items: center; text-align: center;
    gap: 1.5rem;
  }
  .zenith-footer__brand-link {
    display: inline-flex; align-items: center; gap: 0.75rem; text-decoration: none;
  }
  .zenith-footer__brand-link img { height: 72px; width: auto; display: block; }
  .zenith-footer__blurb {
    max-width: 44rem; margin: 0;
    font-size: 1.1875rem; line-height: 1.7;
    color: rgba(255,255,255,0.85);
  }
  .zenith-footer__nav {
    display: flex; flex-wrap: wrap; justify-content: center;
    gap: 1rem 2rem;
  }
  .zenith-footer__nav a {
    color: rgba(255,255,255,0.85);
    font-family: var(--zenith-font-display);
    font-size: 14px; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.1em;
    text-decoration: none;
    transition: color 0.18s;
  }
  .zenith-footer__nav a:hover { color: var(--zenith-lime); }
  .zenith-footer__socials { display: flex; justify-content: center; gap: 0.75rem; }
  .zenith-footer__social {
    width: 42px; height: 42px; border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.22);
    display: inline-flex; align-items: center; justify-content: center;
    color: rgba(255,255,255,0.85);
    transition: background 0.18s, color 0.18s, border-color 0.18s, transform 0.18s;
  }
  .zenith-footer__social:hover {
    background: var(--zenith-lime); color: var(--zenith-navy-deep);
    border-color: var(--zenith-lime); transform: translateY(-2px);
  }
  .zenith-footer__social svg { width: 20px; height: 20px; }
  .zenith-footer__email {
    color: rgba(255,255,255,0.8);
    font-size: 0.95rem; text-decoration: none;
    border-bottom: 1px solid rgba(255,255,255,0.25);
    padding-bottom: 2px;
  }
  .zenith-footer__email:hover { color: var(--zenith-lime); border-color: var(--zenith-lime); }

  .zenith-footer__trust {
    margin-top: 3rem;
    padding: 1.75rem 0;
    border-top: 1px solid rgba(255,255,255,0.08);
    border-bottom: 1px solid rgba(255,255,255,0.08);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
  }
  @media (min-width: 768px) {
    .zenith-footer__trust {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      text-align: left;
    }
  }
  .zenith-footer__trust-badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1rem 1.5rem;
  }
  @media (min-width: 768px) { .zenith-footer__trust-badges { justify-content: flex-start; } }
  .zenith-footer__trust-badge {
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.85);
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .zenith-trust-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    color: var(--zenith-lime);
  }
  .zenith-backtotop {
    position: fixed; left: 1.5rem; bottom: 3.5rem;
    width: 50px; height: 50px;
    border-radius: 50%;
    background: var(--zenith-lime);
    color: var(--zenith-navy-deep);
    border: none;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(0,0,0,0.35);
    opacity: 0; visibility: hidden; transform: translateY(10px);
    transition: opacity 0.25s, transform 0.25s, visibility 0.25s;
    z-index: 60;
  }
  .zenith-backtotop.is-visible { opacity: 1; visibility: visible; transform: translateY(0); }
  .zenith-backtotop svg { width: 22px; height: 22px; }
  .zenith-backtotop:hover { background: #2fe3b6; }
  .zenith-footer__payments {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
  }
  @media (min-width: 768px) { .zenith-footer__payments { justify-content: flex-end; } }
  .zenith-footer__payment {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 24px;
    padding: 2px;
    background: #fff;
    border-radius: 4px;
  }
  .zenith-footer__payment .zenith-footer__payment-svg,
  .zenith-footer__payment svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .zenith-footer__payment-text {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.7);
  }
</style>

{% schema %}
{
  "name": "Zenith Footer",
  "tag": "section",
  "class": "zenith-footer-section",
  "settings": [
    {
      "type": "text",
      "id": "logo_url",
      "label": "Logo URL (defaults to bespoke Zenith logo)",
      "default": "https://zenithsports.org/cdn/shop/files/Zenith_Sports-02-removebg-preview.png"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Brand tagline (small lime text under logo)",
      "default": "Home of the TEKKY(TM)"
    },
    {
      "type": "richtext",
      "id": "brand_blurb",
      "label": "Brand blurb paragraph",
      "default": "<p>Building Better Players, One Touch at a Time. The TEKKY&trade; is an innovative training tool designed to reshape the future of US Soccer by building a stronger technical foundation for the next generation of players.</p>"
    },
    {
      "type": "header",
      "content": "Contact"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Contact email",
      "default": "info@zenithsports.org"
    },
    {
      "type": "text",
      "id": "instagram_url",
      "label": "Instagram URL",
      "default": "https://www.instagram.com/tekkybyzenithsports/"
    },
    {
      "type": "text",
      "id": "facebook_url",
      "label": "Facebook URL",
      "default": "https://www.facebook.com/p/TEKKY-by-Zenith-Sports-61578752395790/"
    },
    {
      "type": "text",
      "id": "youtube_url",
      "label": "YouTube channel URL",
      "default": "https://www.youtube.com/@TEKKYbyZenithSports"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Quick link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "text",
          "id": "url",
          "label": "URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Zenith Footer",
      "blocks": [
        { "type": "link", "settings": { "label": "Home" } },
        { "type": "link", "settings": { "label": "Shop the TEKKY™" } },
        { "type": "link", "settings": { "label": "Training Guide" } },
        { "type": "link", "settings": { "label": "Build Your Player" } },
        { "type": "link", "settings": { "label": "Contact" } }
      ]
    }
  ]
}
{% endschema %}
