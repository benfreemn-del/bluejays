{% comment %}
  TEKKY "In Action" video gallery.

  A cinematic grid of brand b-roll clips (from the Apr 2026 hero shoot).
  Each clip block holds a Shopify-hosted MP4 + a poster image. Clips are
  muted, silent loops: they lazy-load and play on hover (desktop) or when
  scrolled into view (mobile), falling back to the poster image otherwise.

  Upload the transcoded clips + posters in Shopify admin > Content > Files,
  then point each block's URLs at the CDN (https://zenithsports.org/cdn/shop/files/<name>).
{% endcomment %}

<section class="zenith-section zenith-section--dark zenith-videos" data-zenith-videos>
  <div class="zenith-container">
    <div class="zenith-videos__head">
      {% if section.settings.eyebrow != blank %}
        <p class="zenith-eyebrow">{% render 'zenith-text', text: section.settings.eyebrow %}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="zenith-h2" style="margin-top: 1rem; color: #fff;">
          {% render 'zenith-text', text: section.settings.heading %}
        </h2>
      {% endif %}
      {% if section.settings.intro != blank %}
        <div class="zenith-body" style="margin-top: 1.25rem; max-width: 40rem;">
          {{ section.settings.intro }}
        </div>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="zenith-videos__grid zenith-videos__grid--{{ section.settings.columns }}">
        {% for block in section.blocks %}
          {% if block.type == 'clip' and block.settings.video_url != blank %}
            <figure class="zenith-videos__tile" {{ block.shopify_attributes }}>
              <div class="zenith-videos__frame" data-video-tile>
                <video
                  class="zenith-videos__video"
                  muted
                  loop
                  playsinline
                  preload="none"
                  {% if block.settings.poster_url != blank %}poster="{{ block.settings.poster_url }}"{% endif %}
                  data-src="{{ block.settings.video_url }}"
                ></video>
                <span class="zenith-videos__play" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                </span>
              </div>
              {% if block.settings.label != blank %}
                <figcaption class="zenith-videos__label">{% render 'zenith-text', text: block.settings.label %}</figcaption>
              {% endif %}
            </figure>
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <p class="zenith-body" style="margin-top: 1.5rem; opacity: 0.7;">
        Add clip blocks in the theme customizer to populate this gallery.
      </p>
    {% endif %}
  </div>
</section>

<script>
  (function () {
    var root = document.currentScript.previousElementSibling;
    if (!root || !root.hasAttribute('data-zenith-videos')) {
      root = document.querySelector('[data-zenith-videos]');
    }
    if (!root) return;

    var tiles = root.querySelectorAll('[data-video-tile]');
    var isTouch = window.matchMedia('(hover: none)').matches;
    var saveData = navigator.connection && navigator.connection.saveData;

    function ensureSrc(video) {
      if (!video.getAttribute('src') && video.dataset.src) {
        video.setAttribute('src', video.dataset.src);
      }
    }

    // Desktop: play on hover, pause on leave.
    if (!isTouch) {
      tiles.forEach(function (tile) {
        var video = tile.querySelector('video');
        tile.addEventListener('mouseenter', function () {
          ensureSrc(video);
          var p = video.play();
          if (p && p.catch) p.catch(function () {});
        });
        tile.addEventListener('mouseleave', function () {
          video.pause();
        });
      });
    }

    // Mobile / no-hover: autoplay the clip while it's on screen.
    // Skipped on data-saver — those users tap a tile to play.
    if (isTouch && !saveData && 'IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          var video = entry.target.querySelector('video');
          if (entry.isIntersecting && entry.intersectionRatio > 0.6) {
            ensureSrc(video);
            var p = video.play();
            if (p && p.catch) p.catch(function () {});
          } else {
            video.pause();
          }
        });
      }, { threshold: [0, 0.6, 1] });
      tiles.forEach(function (tile) { io.observe(tile); });
    }

    // Tap to toggle play/pause on touch as a manual override.
    tiles.forEach(function (tile) {
      tile.addEventListener('click', function () {
        var video = tile.querySelector('video');
        ensureSrc(video);
        if (video.paused) {
          var p = video.play();
          if (p && p.catch) p.catch(function () {});
        } else {
          video.pause();
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Zenith Video Gallery",
  "tag": "section",
  "class": "zenith-video-gallery-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (small lime text)",
      "default": "On the pitch"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "TEKKY in action"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro paragraph",
      "default": "<p>Real reps, real players. Every touch on the TEKKY&trade; transfers straight to match day.</p>"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns (desktop)",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    }
  ],
  "blocks": [
    {
      "type": "clip",
      "name": "Video clip",
      "settings": [
        {
          "type": "text",
          "id": "video_url",
          "label": "Video URL (mp4 from Shopify Files)",
          "info": "Upload in Content > Files, then paste the CDN URL ending in .mp4"
        },
        {
          "type": "text",
          "id": "poster_url",
          "label": "Poster image URL (shown before play)"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Caption (optional)"
        }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "Zenith Video Gallery",
      "blocks": [
        { "type": "clip" },
        { "type": "clip" },
        { "type": "clip" },
        { "type": "clip" },
        { "type": "clip" },
        { "type": "clip" }
      ]
    }
  ]
}
{% endschema %}
