</style>

<script>
  (function () {
    // ── ELEMENT REFS ────────────────────────────────────────────────────────
    var root = document.querySelector('.zenith-camps');
    if (!root) return;

    var STEPS = ['age', 'location', 'travel', 'skill', 'format', 'timing', 'notify'];

    var STATE_NAMES = {
      AL:'Alabama',AK:'Alaska',AZ:'Arizona',AR:'Arkansas',CA:'California',CO:'Colorado',CT:'Connecticut',DE:'Delaware',FL:'Florida',GA:'Georgia',HI:'Hawaii',ID:'Idaho',IL:'Illinois',IN:'Indiana',IA:'Iowa',KS:'Kansas',KY:'Kentucky',LA:'Louisiana',ME:'Maine',MD:'Maryland',MA:'Massachusetts',MI:'Michigan',MN:'Minnesota',MS:'Mississippi',MO:'Missouri',MT:'Montana',NE:'Nebraska',NV:'Nevada',NH:'New Hampshire',NJ:'New Jersey',NM:'New Mexico',NY:'New York',NC:'North Carolina',ND:'North Dakota',OH:'Ohio',OK:'Oklahoma',OR:'Oregon',PA:'Pennsylvania',RI:'Rhode Island',SC:'South Carolina',SD:'South Dakota',TN:'Tennessee',TX:'Texas',UT:'Utah',VT:'Vermont',VA:'Virginia',WA:'Washington',WV:'West Virginia',WI:'Wisconsin',WY:'Wyoming'
    };

    // Availability estimation constants — same shape as data/camp-estimates.ts
    var TOTAL_US_CAMPS = 22000;
    var AGE_MULT = { 'U6-U8':0.18,'U9-U10':0.22,'U11-U12':0.25,'U13-U14':0.22,'U15-U16':0.18,'U17-U19':0.12 };
    var SKILL_MULT = { beginner:0.4, rec:0.55, select:0.35, elite:0.18 };
    var FORMAT_MULT = { 'day-camp':0.55,'residential':0.25,'clinic':0.35,'demo':0.1 };
    var TIMING_MULT = { 'summer-2026':0.55,'fall-2026':0.12,'winter-2026':0.08,'spring-2027':0.1 };
    // State-level slice as a fraction of total US (rough — same purpose as
    // CAMPS_BY_STATE in the Next.js data file). Defaults to 0.02 for missing.
    var STATE_FRAC = {
      CA:0.13, TX:0.09, FL:0.07, NY:0.06, PA:0.045, IL:0.04, OH:0.04, GA:0.035, NC:0.035, MI:0.03,
      NJ:0.03, VA:0.03, WA:0.028, MA:0.025, AZ:0.025, IN:0.022, MN:0.022, MO:0.02, WI:0.02, CO:0.02,
      MD:0.02, TN:0.022, SC:0.02, AL:0.018, OR:0.018, KY:0.015, LA:0.015, OK:0.014, CT:0.014, UT:0.014,
      IA:0.012, NV:0.012, KS:0.011, AR:0.011, MS:0.01, NM:0.009, NE:0.009, WV:0.008, ID:0.008, HI:0.007,
      NH:0.006, ME:0.006, MT:0.005, RI:0.005, DE:0.004, SD:0.004, ND:0.004, AK:0.003, VT:0.003, WY:0.002
    };

    // ── STATE ──────────────────────────────────────────────────────────────
    var state = {
      step: 'age',
      ageGroups: [],
      stateCode: '',
      county: '',
      travelMiles: 50,
      skillLevels: [],
      formats: [],
      timings: [],
      parentName: '',
      email: '',
      phone: '',
      playerName: '',
      notifyOptIn: true,
      smsConsent: false
    };

    // ── HELPERS ────────────────────────────────────────────────────────────
    function $(sel, ctx) { return (ctx || root).querySelector(sel); }
    function $$(sel, ctx) { return Array.prototype.slice.call((ctx || root).querySelectorAll(sel)); }

    function estimateAvailability() {
      var count = TOTAL_US_CAMPS;
      if (state.stateCode) {
        var stateFrac = STATE_FRAC[state.stateCode] || 0.02;
        var stateCount = TOTAL_US_CAMPS * stateFrac;
        var m = state.travelMiles;
        var radiusFrac;
        if (m <= 30) radiusFrac = 0.25;
        else if (m <= 60) radiusFrac = 0.45;
        else if (m <= 100) radiusFrac = 0.7;
        else if (m <= 150) radiusFrac = 0.9;
        else if (m <= 200) radiusFrac = 1.0;
        else radiusFrac = Math.min(1.4, 1.0 + (m - 200) / 250);
        count = stateCount * radiusFrac;
      }
      if (state.ageGroups.length > 0) {
        var s1 = state.ageGroups.reduce(function (a, id) { return a + (AGE_MULT[id] || 0.18); }, 0);
        count *= Math.min(1, s1);
      }
      if (state.skillLevels.length > 0) {
        var s2 = state.skillLevels.reduce(function (a, id) { return a + (SKILL_MULT[id] || 0.3); }, 0);
        count *= Math.min(1, s2);
      }
      if (state.formats.length > 0) {
        var s3 = state.formats.reduce(function (a, id) { return a + (FORMAT_MULT[id] || 0); }, 0);
        count *= Math.min(1, s3);
      }
      if (state.timings.length > 0 && state.timings.length < 4) {
        var s4 = state.timings.reduce(function (a, id) { return a + (TIMING_MULT[id] || 0.3); }, 0);
        count *= Math.min(1, s4);
      }
      return Math.max(1, Math.round(count));
    }

    function canAdvance() {
      if (state.step === 'age') return state.ageGroups.length >= 1;
      if (state.step === 'location') return state.stateCode !== '' && state.county.trim().length >= 2;
      if (state.step === 'travel') return state.travelMiles > 0;
      if (state.step === 'skill') return state.skillLevels.length >= 1;
      if (state.step === 'format') return state.formats.length >= 1;
      if (state.step === 'timing') return state.timings.length >= 1;
      if (state.step === 'notify') return state.parentName.trim().length >= 2 && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(state.email);
      return false;
    }

    // ── RENDER ─────────────────────────────────────────────────────────────
    function renderStep() {
      $$('.zenith-camps__step').forEach(function (el) {
        el.hidden = el.getAttribute('data-step') !== state.step;
      });
      var idx = STEPS.indexOf(state.step);
      $('[data-step-num]').textContent = idx + 1;
      var pct = Math.round(((idx + 1) / 7) * 100);
      $('[data-step-pct]').textContent = pct;
      $('[data-progress-fill]').style.width = pct + '%';

      // Back button visible from step 2+
      var backBtn = $('[data-back]');
      if (backBtn) backBtn.hidden = idx === 0;

      // Hide Next + Back on notify step (form has its own submit button)
      var nav = $('[data-nav]');
      if (nav) nav.hidden = state.step === 'notify';

      // Hide availability rail on notify step (no more filtering to show)
      var rail = $('[data-rail]');
      if (rail) rail.style.display = (state.step === 'notify') ? 'none' : '';

      var nextBtn = $('[data-next]');
      if (nextBtn) nextBtn.disabled = !canAdvance();

      var submitBtn = $('[data-submit]');
      if (submitBtn) submitBtn.disabled = !canAdvance();

      renderRail();
      renderCounts();
      renderSummaries();
    }

    function renderCounts() {
      var ageC = $('[data-count-age]'); if (ageC) ageC.textContent = state.ageGroups.length;
      var skC = $('[data-count-skill]'); if (skC) skC.textContent = state.skillLevels.length;
      var tC = $('[data-count-timing]'); if (tC) tC.textContent = state.timings.length;
      var any = $('[data-any-time]'); if (any) any.textContent = state.timings.length === 4 ? ' · any time' : '';
    }

    function renderSummaries() {
      var locTxt = state.county || state.stateCode ? (state.county + (state.stateCode ? (', ' + state.stateCode) : '')) : 'you';
      var loc = $('[data-summary-loc]'); if (loc) loc.textContent = locTxt;
      var st = $('[data-summary-state]'); if (st) st.textContent = state.stateCode ? STATE_NAMES[state.stateCode] : 'me';
      var em = $('[data-summary-email]'); if (em) em.textContent = state.email || 'your inbox';
    }

    function renderRail() {
      var count = estimateAvailability();
      var pct = Math.min(100, (count / TOTAL_US_CAMPS) * 100);
      var color = pct > 25 ? '#00c49a' : pct > 5 ? '#fbbf24' : '#1d4ed8';

      var num = $('[data-rail-count]');
      if (num) { num.textContent = count.toLocaleString(); num.style.color = color; }
      var fill = $('[data-rail-fill]');
      if (fill) {
        fill.style.width = pct + '%';
        fill.style.background = 'linear-gradient(90deg, ' + color + ' 0%, ' + color + '99 100%)';
      }
      var p = $('[data-rail-pct]'); if (p) p.textContent = pct.toFixed(pct < 1 ? 2 : 1);

      var notes = {
        age: 'Pick an age band → narrows by participation share',
        location: 'Pick your state → collapses to local catalog',
        travel: 'Wider radius = more camps on the table',
        skill: 'Skill picks tier of programming',
        format: 'Format trims to day / residential / clinic',
        timing: 'Season slices the calendar',
        notify: ''
      };
      var n = $('[data-rail-note]'); if (n) n.textContent = notes[state.step] || '';

      function setRailRow(key, on, value) {
        var el = $('[data-rail-' + key + ']');
        if (!el) return;
        el.textContent = on ? (value || '—') : '—';
        var li = el.closest('li');
        if (li) { if (on) li.setAttribute('data-on', ''); else li.removeAttribute('data-on'); }
      }
      setRailRow('age', state.ageGroups.length > 0, state.ageGroups.join(' + '));
      setRailRow('state', !!state.stateCode, STATE_NAMES[state.stateCode] || state.stateCode);
      setRailRow('county', !!state.county, state.county);
      setRailRow('travel', state.travelMiles !== 50, state.travelMiles + ' mi');
      setRailRow('skill', state.skillLevels.length > 0, state.skillLevels.join(' + '));
      setRailRow('format', state.formats.length > 0, state.formats.join(', '));
      setRailRow('timing', state.timings.length > 0, state.timings.length === 4 ? 'any time' : state.timings.join(' + '));
    }

    function renderTravel() {
      var m = state.travelMiles;
      var pct = Math.min(100, Math.max(0, ((m - 5) / (300 - 5)) * 100));
      var hours = Math.max(0.1, m / 55);
      var carScale = 0.9 + (pct / 100) * 0.6;
      var tier = m <= 30 ? '🏠 Right around the corner'
        : m <= 75 ? '🚗 Easy weekday drive'
        : m <= 150 ? '🛣️ Weekend road trip'
        : m <= 250 ? '🗺️ Big day out'
        : '🌎 Anywhere in driving range';

      var n = $('[data-travel-num]'); if (n) n.textContent = m;
      var h = $('[data-travel-hours]'); if (h) h.textContent = hours.toFixed(1);
      var t = $('[data-travel-tier]'); if (t) t.textContent = tier;
      var f = $('[data-highway-fill]'); if (f) f.style.width = pct + '%';
      var c = $('[data-highway-car]');
      if (c) {
        c.style.left = 'calc(' + pct + '% - 16px)';
        c.style.transform = 'translateY(-50%) scale(' + carScale + ') scaleX(-1)';
      }
    }

    // ── INTERACTIONS ───────────────────────────────────────────────────────
    function togglePick(key, id, cap) {
      var arr = state[key];
      var i = arr.indexOf(id);
      if (i >= 0) { arr.splice(i, 1); }
      else {
        if (cap && arr.length >= cap) return;
        arr.push(id);
      }
      paintPicks(key);
      renderStep();
    }

    function paintPicks(key) {
      var dataKey = key === 'ageGroups' ? 'age'
        : key === 'skillLevels' ? 'skill'
        : key === 'formats' ? 'format'
        : key === 'timings' ? 'timing' : key;
      $$('[data-pick="' + dataKey + '"]').forEach(function (btn) {
        var id = btn.getAttribute('data-id');
        var active = state[key].indexOf(id) >= 0;
        btn.classList.toggle('zenith-camps__opt--active', active);
        var cap = parseInt(btn.getAttribute('data-cap') || '0', 10);
        var atCap = cap > 0 && !active && state[key].length >= cap;
        btn.classList.toggle('zenith-camps__opt--disabled', atCap);
        btn.disabled = atCap;
      });
    }

    // Wire option-pick buttons
    $$('[data-pick]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var dataKey = btn.getAttribute('data-pick');
        var stateKey = dataKey === 'age' ? 'ageGroups'
          : dataKey === 'skill' ? 'skillLevels'
          : dataKey === 'format' ? 'formats'
          : dataKey === 'timing' ? 'timings' : dataKey;
        var id = btn.getAttribute('data-id');
        var cap = parseInt(btn.getAttribute('data-cap') || '0', 10);
        togglePick(stateKey, id, cap);
      });
    });

    // Wire location inputs
    var stateSel = $('[data-input="state"]');
    if (stateSel) stateSel.addEventListener('change', function (e) {
      state.stateCode = e.target.value;
      renderStep();
    });
    var countyIn = $('[data-input="county"]');
    if (countyIn) countyIn.addEventListener('input', function (e) {
      state.county = e.target.value;
      renderStep();
    });

    // Wire travel slider
    var travelIn = $('[data-input="travel"]');
    if (travelIn) {
      travelIn.addEventListener('input', function (e) {
        state.travelMiles = parseInt(e.target.value, 10);
        renderTravel();
        renderRail();
      });
    }

    // Wire notify inputs
    var pName = $('[data-input="parent-name"]');
    var pEmail = $('[data-input="email"]');
    var pPhone = $('[data-input="phone"]');
    var pPlayer = $('[data-input="player-name"]');
    var pNotify = $('[data-input="notify-opt"]');
    var pSms = $('[data-input="sms-consent"]');
    var pNote = $('[data-input="note"]');

    if (pName) pName.addEventListener('input', function (e) { state.parentName = e.target.value; renderStep(); });
    if (pEmail) pEmail.addEventListener('input', function (e) { state.email = e.target.value; renderStep(); });
    if (pPhone) pPhone.addEventListener('input', function (e) { state.phone = e.target.value; });
    if (pPlayer) pPlayer.addEventListener('input', function (e) { state.playerName = e.target.value; });
    if (pNotify) pNotify.addEventListener('change', function (e) { state.notifyOptIn = e.target.checked; });
    if (pSms) pSms.addEventListener('change', function (e) { state.smsConsent = e.target.checked; });

    // Build the hidden contact[note] payload on submit so Philip sees the
    // full quiz snapshot in the Shopify customer record.
    var form = root.querySelector('form');
    if (form) {
      form.addEventListener('submit', function () {
        if (pNote) {
          pNote.value = [
            'TEKKY™ Camp Finder submission',
            'Age: ' + state.ageGroups.join(' + '),
            'Location: ' + state.county + ', ' + (STATE_NAMES[state.stateCode] || state.stateCode),
            'Travel: up to ' + state.travelMiles + ' miles',
            'Skill: ' + state.skillLevels.join(' + '),
            'Format: ' + state.formats.join(', '),
            'When: ' + (state.timings.length === 4 ? 'any time' : state.timings.join(' + ')),
            'Player: ' + (state.playerName || '—'),
            'Phone: ' + (state.phone || '—'),
            'SMS consent: ' + (state.smsConsent ? 'yes' : 'no'),
            'Notify opt-in: ' + (state.notifyOptIn ? 'yes' : 'no')
          ].join('\n');
        }
      });
    }

    // Wire navigation
    var nextBtn = $('[data-next]');
    if (nextBtn) nextBtn.addEventListener('click', function () {
      if (!canAdvance()) return;
      var idx = STEPS.indexOf(state.step);
      if (idx < STEPS.length - 1) {
        state.step = STEPS[idx + 1];
        renderStep();
        window.scrollTo({ top: root.offsetTop - 20, behavior: 'smooth' });
      }
    });
    var backBtn = $('[data-back]');
    if (backBtn) backBtn.addEventListener('click', function () {
      var idx = STEPS.indexOf(state.step);
      if (idx > 0) {
        state.step = STEPS[idx - 1];
        renderStep();
      }
    });

    // INIT
    renderStep();
    renderTravel();
  })();
</script>

