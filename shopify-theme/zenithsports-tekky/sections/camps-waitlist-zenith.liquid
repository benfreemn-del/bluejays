{% comment %}
  Camp Finder Quiz — full interactive multi-step state machine.

  Ports the Next.js /clients/zenith-sports/camps page to vanilla JS
  inside a Shopify section. Same 7-step flow, same multi-select rules,
  same animated travel slider, same live availability rail.

  Steps:
    1. Age (multi-select up to 2)
    2. Location (state select + county text input)
    3. Travel (slider 5-300 miles, animated car emoji)
    4. Skill (multi-select up to 2)
    5. Format (multi-select)
    6. Timing (multi-select; all 4 = "any time")
    7. Notify (parent name, email, phone, player name, opt-ins) → submits
       to Shopify customer form with tag 'camp-waitlist'

  Lead lands in Shopify Admin -> Customers tagged 'camp-waitlist' with
  the full quiz snapshot baked into a Note field so Philip can match
  parents to camps as the catalog grows.

  Note: the SVG state map and county autocomplete from the Next.js
  version aren't ported here — Liquid sections that ship a 50-state SVG
  + counties JSON would balloon to >100KB. Native <select> for state and
  free-text county input cover the same data capture.
{% endcomment %}

<section class="zenith-section zenith-camps">
  <div class="zenith-container">

    {%- comment -%} ── HEADER ── {%- endcomment -%}
    <header class="zenith-camps__head">
      {% if section.settings.eyebrow != blank %}
        <p class="zenith-eyebrow zenith-camps__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      <h1 class="zenith-camps__title">
        {{ section.settings.headline_top | escape }}
        <br />
        <span class="zenith-camps__title-accent">{{ section.settings.headline_accent | escape }}</span>
      </h1>
      {% if section.settings.subhead != blank %}
        <div class="zenith-camps__subhead">{{ section.settings.subhead }}</div>
      {% endif %}
    </header>

    {%- comment -%} ── PROGRESS BAR ── {%- endcomment -%}
    <div class="zenith-camps__progress" data-progress>
      <div class="zenith-camps__progress-meta">
        <span class="zenith-camps__progress-step">Step <span data-step-num>1</span> of 7</span>
        <span class="zenith-camps__progress-pct"><span data-step-pct>14</span>%</span>
      </div>
      <div class="zenith-camps__progress-track">
        <div class="zenith-camps__progress-fill" data-progress-fill></div>
      </div>
      <div class="zenith-camps__stat-banner">
        <span aria-hidden="true">📊</span>
        <p><strong>3M+ U.S. kids</strong> play registered youth soccer — the #1 youth team sport. Camps are how the top players sharpen the gap.</p>
      </div>
    </div>

    {%- comment -%} ── QUIZ GRID: question + availability rail ── {%- endcomment -%}
    <div class="zenith-camps__grid">

      {%- comment -%} ── LEFT: QUESTION PANE ── {%- endcomment -%}
      <div class="zenith-camps__pane">

        {%- comment -%} STEP 1 · AGE {%- endcomment -%}
        <div class="zenith-camps__step" data-step="age">
          <p class="zenith-camps__qnum">Question 1 of 7</p>
          <h2 class="zenith-camps__qtitle">How old is your player?</h2>
          <p class="zenith-camps__qbody">Pick the closest band — or two if your player is in between. Camp programming is built around the age group, so picking both widens the camps we'll watch for on your behalf.</p>
          <p class="zenith-camps__qcount"><span data-count-age>0</span> / 2 selected</p>
          <div class="zenith-camps__opts zenith-camps__opts--grid3">
            {%- assign age_ids = "U6-U8,U9-U10,U11-U12,U13-U14,U15-U16,U17-U19" | split: "," -%}
            {%- assign age_labels = "U6 – U8,U9 – U10,U11 – U12,U13 – U14,U15 – U16,U17 – U19" | split: "," -%}
            {%- assign age_emojis = "🌱,⚡,🎯,🔥,🏆,⭐" | split: "," -%}
            {%- assign age_notes = "Just starting out,Growing fast,Skill-building age,Position decisions,Tryout & HS prep,College recruitment" | split: "," -%}
            {%- for id in age_ids -%}
              {%- assign idx = forloop.index0 -%}
              <button type="button" class="zenith-camps__opt" data-pick="age" data-id="{{ id }}" data-cap="2">
                <span class="zenith-camps__opt-check">✓</span>
                <div class="zenith-camps__opt-emoji">{{ age_emojis[idx] }}</div>
                <div class="zenith-camps__opt-label">{{ age_labels[idx] }}</div>
                <div class="zenith-camps__opt-note">{{ age_notes[idx] }}</div>
              </button>
            {%- endfor -%}
          </div>
        </div>

        {%- comment -%} STEP 2 · LOCATION {%- endcomment -%}
        <div class="zenith-camps__step" data-step="location" hidden>
          <p class="zenith-camps__qnum">Question 2 of 7</p>
          <h2 class="zenith-camps__qtitle">Where do you live?</h2>
          <p class="zenith-camps__qbody">Pick your state so we can watch for TEKKY™ camps within driving distance and notify you the moment one opens.</p>
          <label class="zenith-camps__field">
            <span>State *</span>
            <select data-input="state">
              <option value="">— pick your state —</option>
              {%- assign state_codes = "AL,AK,AZ,AR,CA,CO,CT,DE,FL,GA,HI,ID,IL,IN,IA,KS,KY,LA,ME,MD,MA,MI,MN,MS,MO,MT,NE,NV,NH,NJ,NM,NY,NC,ND,OH,OK,OR,PA,RI,SC,SD,TN,TX,UT,VT,VA,WA,WV,WI,WY" | split: "," -%}
              {%- assign state_names = "Alabama,Alaska,Arizona,Arkansas,California,Colorado,Connecticut,Delaware,Florida,Georgia,Hawaii,Idaho,Illinois,Indiana,Iowa,Kansas,Kentucky,Louisiana,Maine,Maryland,Massachusetts,Michigan,Minnesota,Mississippi,Missouri,Montana,Nebraska,Nevada,New Hampshire,New Jersey,New Mexico,New York,North Carolina,North Dakota,Ohio,Oklahoma,Oregon,Pennsylvania,Rhode Island,South Carolina,South Dakota,Tennessee,Texas,Utah,Vermont,Virginia,Washington,West Virginia,Wisconsin,Wyoming" | split: "," -%}
              {%- for code in state_codes -%}
                <option value="{{ code }}">{{ state_names[forloop.index0] }}</option>
              {%- endfor -%}
            </select>
          </label>
          <label class="zenith-camps__field">
            <span>County *</span>
            <input type="text" data-input="county" placeholder="e.g. King · Clallam · Maricopa" autocomplete="off" />
            <small class="zenith-camps__hint">Type your county so we can match the nearest camps.</small>
          </label>
        </div>

        {%- comment -%} STEP 3 · TRAVEL {%- endcomment -%}
        <div class="zenith-camps__step" data-step="travel" hidden>
          <p class="zenith-camps__qnum">Question 3 of 7</p>
          <h2 class="zenith-camps__qtitle">How far can you travel?</h2>
          <p class="zenith-camps__qbody">Drag the slider — the car shows your reach. Wider radius = more camps on the table.</p>

          <div class="zenith-camps__travel-readout">
            <div class="zenith-camps__travel-tier" data-travel-tier>🏠 Right around the corner</div>
            <div class="zenith-camps__travel-num"><span data-travel-num>50</span><span class="zenith-camps__travel-unit">miles</span></div>
            <div class="zenith-camps__travel-hours">≈ <span data-travel-hours>0.9</span> hours each way</div>
          </div>

          <div class="zenith-camps__highway">
            <div class="zenith-camps__highway-marks">
              <span>5 mi</span><span>50</span><span>100</span><span>200</span><span>300+</span>
            </div>
            <div class="zenith-camps__highway-road">
              <div class="zenith-camps__highway-fill" data-highway-fill></div>
              <div class="zenith-camps__highway-stripes"></div>
              <div class="zenith-camps__highway-car" data-highway-car aria-hidden="true">🚗</div>
            </div>
            <input type="range" min="5" max="300" step="5" value="50" data-input="travel" aria-label="Travel distance in miles" class="zenith-camps__highway-range" />
          </div>

          <p class="zenith-camps__qhint">Most parents drive 30-60 miles for a great camp. Big-name residential camps pull from 200+ mile radii.</p>
        </div>

        {%- comment -%} STEP 4 · SKILL {%- endcomment -%}
        <div class="zenith-camps__step" data-step="skill" hidden>
          <p class="zenith-camps__qnum">Question 4 of 7</p>
          <h2 class="zenith-camps__qtitle">Where are they at?</h2>
          <p class="zenith-camps__qbody">Pick the closest level — or two if they straddle. Beginner camps feel different from elite tryout-prep camps; picking two adjacent tiers opens more matches.</p>
          <p class="zenith-camps__qcount"><span data-count-skill>0</span> / 2 selected</p>
          <div class="zenith-camps__opts zenith-camps__opts--grid2">
            {%- assign skill_ids = "beginner,rec,select,elite" | split: "," -%}
            {%- assign skill_labels = "Just starting,Rec / casual,Select / club,Elite / ECNL" | split: "," -%}
            {%- assign skill_emojis = "🌱,⚽,⚡,🏆" | split: "," -%}
            {%- for id in skill_ids -%}
              {%- assign idx = forloop.index0 -%}
              <button type="button" class="zenith-camps__opt" data-pick="skill" data-id="{{ id }}" data-cap="2">
                <span class="zenith-camps__opt-check">✓</span>
                <div class="zenith-camps__opt-emoji zenith-camps__opt-emoji--lg">{{ skill_emojis[idx] }}</div>
                <div class="zenith-camps__opt-label">{{ skill_labels[idx] }}</div>
              </button>
            {%- endfor -%}
          </div>
        </div>

        {%- comment -%} STEP 5 · FORMAT {%- endcomment -%}
        <div class="zenith-camps__step" data-step="format" hidden>
          <p class="zenith-camps__qnum">Question 5 of 7</p>
          <h2 class="zenith-camps__qtitle">What format works for your family?</h2>
          <p class="zenith-camps__qbody">Pick any that work — we'll surface camps that match.</p>
          <div class="zenith-camps__opts zenith-camps__opts--grid2">
            {%- assign fmt_ids = "day-camp,residential,clinic,demo" | split: "," -%}
            {%- assign fmt_labels = "Day camp,Residential,Clinic,Demo / open house" | split: "," -%}
            {%- assign fmt_emojis = "☀️,🏕️,🎯,👋" | split: "," -%}
            {%- assign fmt_notes = "Drop-off mornings,Sleep-away weeks,1-2 day skill clinics,Try-it-out events" | split: "," -%}
            {%- for id in fmt_ids -%}
              {%- assign idx = forloop.index0 -%}
              <button type="button" class="zenith-camps__opt" data-pick="format" data-id="{{ id }}">
                <span class="zenith-camps__opt-check">✓</span>
                <div class="zenith-camps__opt-emoji">{{ fmt_emojis[idx] }}</div>
                <div class="zenith-camps__opt-label">{{ fmt_labels[idx] }}</div>
                <div class="zenith-camps__opt-note">{{ fmt_notes[idx] }}</div>
              </button>
            {%- endfor -%}
          </div>
        </div>

        {%- comment -%} STEP 6 · TIMING {%- endcomment -%}
        <div class="zenith-camps__step" data-step="timing" hidden>
          <p class="zenith-camps__qnum">Question 6 of 7</p>
          <h2 class="zenith-camps__qtitle">When are you looking?</h2>
          <p class="zenith-camps__qbody">Pick any or all — flexible families that tick multiple windows unlock more matches.</p>
          <p class="zenith-camps__qcount"><span data-count-timing>0</span> / 4 selected<span data-any-time></span></p>
          <div class="zenith-camps__opts zenith-camps__opts--stack">
            {%- assign t_ids = "summer-2026,fall-2026,winter-2026,spring-2027" | split: "," -%}
            {%- assign t_labels = "Summer 2026,Fall break 2026,Winter 2026/27,Spring 2027" | split: "," -%}
            {%- assign t_emojis = "☀️,🍂,❄️,🌸" | split: "," -%}
            {%- for id in t_ids -%}
              {%- assign idx = forloop.index0 -%}
              <button type="button" class="zenith-camps__opt zenith-camps__opt--row" data-pick="timing" data-id="{{ id }}">
                <span class="zenith-camps__opt-check">✓</span>
                <span class="zenith-camps__opt-emoji">{{ t_emojis[idx] }}</span>
                <span class="zenith-camps__opt-label">{{ t_labels[idx] }}</span>
              </button>
            {%- endfor -%}
          </div>
        </div>

        {%- comment -%} STEP 7 · NOTIFY (lead capture via Shopify customer form) {%- endcomment -%}
        <div class="zenith-camps__step" data-step="notify" hidden>
          <p class="zenith-camps__qnum">Last question</p>
          <h2 class="zenith-camps__qtitle">Where should we send camp openings?</h2>
          <p class="zenith-camps__qbody">TEKKY™ camps are rolling out by region. Drop your info and we'll notify you the moment one opens near <span data-summary-loc>you</span>.</p>

          {% form 'customer', class: 'zenith-camps__form' %}
            <input type="hidden" name="contact[tags]" value="camp-waitlist, zenith-tekky" />
            <input type="hidden" name="contact[note]" data-input="note" value="" />
            <input type="hidden" name="contact[accepts_marketing]" value="1" />

            <label class="zenith-camps__field">
              <span>Your name *</span>
              <input type="text" name="contact[first_name]" data-input="parent-name" required placeholder="Sarah Williams" autocomplete="name" />
            </label>

            <label class="zenith-camps__field">
              <span>Email *</span>
              <input type="email" name="contact[email]" data-input="email" required placeholder="sarah@example.com" autocomplete="email" />
            </label>

            <div class="zenith-camps__field-row">
              <label class="zenith-camps__field">
                <span>Player's name (optional)</span>
                <input type="text" name="contact[last_name]" data-input="player-name" placeholder="Maya" />
              </label>
              <label class="zenith-camps__field">
                <span>Phone (optional)</span>
                <input type="tel" name="contact[phone]" data-input="phone" placeholder="(555) 123-4567" autocomplete="tel" />
              </label>
            </div>

            <label class="zenith-camps__consent zenith-camps__consent--primary">
              <input type="checkbox" data-input="notify-opt" checked />
              <span>
                <strong>Yes — notify me</strong> when new camps open near <span data-summary-state>me</span>.
                <small>First-look access. We email when there's a real fit, not on a schedule.</small>
              </span>
            </label>

            <label class="zenith-camps__consent">
              <input type="checkbox" data-input="sms-consent" />
              <span>
                <strong>Optional — text me</strong> camp drops + drill of the week.
                <small>Msg &amp; data rates may apply. Reply STOP to opt out. Consent is not required to submit this form.</small>
              </span>
            </label>

            <button type="submit" class="zenith-btn zenith-btn--primary zenith-camps__submit" data-submit disabled>
              Notify me when camps open →
            </button>

            {% if form.posted_successfully? %}
              <p class="zenith-camps__success">
                ✓ Thanks — you're on the waitlist. Here's what happens next: we'll email <span data-summary-email>you</span> first-look access the moment a TEKKY™ camp opens near you. Nothing else, no spam — just the camp alert.
              </p>
            {% endif %}

            {%- if form.errors -%}
              <p class="zenith-camps__error">{{ form.errors | default_errors }}</p>
            {%- endif -%}
          {% endform %}
        </div>

        {%- comment -%} ── PREV / NEXT NAV (hidden on notify step — form's own submit advances) ── {%- endcomment -%}
        <div class="zenith-camps__nav" data-nav>
          <button type="button" class="zenith-camps__back" data-back hidden>← Back</button>
          <button type="button" class="zenith-btn zenith-btn--primary zenith-camps__next" data-next disabled>
            Next →
          </button>
        </div>

      </div>

      {%- comment -%} ── RIGHT: AVAILABILITY RAIL ── {%- endcomment -%}
      <aside class="zenith-camps__rail" data-rail>
        <div class="zenith-camps__rail-eye">Camps in your funnel</div>
        <div class="zenith-camps__rail-num">
          <span data-rail-count>22,000</span>
          <span class="zenith-camps__rail-total">of 22,000</span>
        </div>
        <div class="zenith-camps__rail-bar">
          <div class="zenith-camps__rail-bar-fill" data-rail-fill></div>
        </div>
        <p class="zenith-camps__rail-pct"><span data-rail-pct>100.0</span>% of US camps still match.</p>
        <p class="zenith-camps__rail-note" data-rail-note>Pick an age band → narrows by participation share</p>

        <ul class="zenith-camps__rail-list">
          <li><span>Age</span><span data-rail-age>—</span></li>
          <li><span>State</span><span data-rail-state>—</span></li>
          <li><span>County</span><span data-rail-county>—</span></li>
          <li><span>Travel</span><span data-rail-travel>—</span></li>
          <li><span>Skill</span><span data-rail-skill>—</span></li>
          <li><span>Format</span><span data-rail-format>—</span></li>
          <li><span>When</span><span data-rail-timing>—</span></li>
        </ul>
      </aside>
    </div>

  </div>
</section>

<style>
  .zenith-camps {
    background: linear-gradient(180deg, var(--zenith-navy-deep) 0%, var(--zenith-navy) 100%);
    color: #fff;
    padding: 3rem 0 5rem;
  }
  @media (min-width: 768px) { .zenith-camps { padding: 5rem 0 7rem; } }

  .zenith-camps__head { text-align: center; max-width: 48rem; margin: 0 auto 2.5rem; }
  .zenith-camps__eyebrow { color: var(--zenith-lime); }
  .zenith-camps__title {
    font-size: clamp(2rem, 5.5vw, 4rem);
    font-weight: 900; line-height: 1;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    color: #fff;
    margin: 0.75rem 0 1.25rem;
  }
  .zenith-camps__title-accent { color: var(--zenith-lime); }
  .zenith-camps__subhead { color: rgba(255,255,255,0.7); line-height: 1.6; }
  .zenith-camps__subhead p { margin: 0; }

  .zenith-camps__progress { max-width: 56rem; margin: 0 auto 2rem; }
  .zenith-camps__progress-meta {
    display: flex; justify-content: space-between;
    font-size: 12px; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.22em;
    color: rgba(255,255,255,0.6);
    margin-bottom: 0.45rem;
  }
  .zenith-camps__progress-pct { color: rgba(255,255,255,0.4); }
  .zenith-camps__progress-track {
    height: 6px; border-radius: 999px;
    background: rgba(255,255,255,0.1);
    overflow: hidden;
  }
  .zenith-camps__progress-fill {
    height: 100%; width: 14.28%;
    background: var(--zenith-lime);
    border-radius: 999px;
    transition: width 0.4s ease;
  }
  .zenith-camps__stat-banner {
    margin-top: 0.85rem;
    display: flex; align-items: center; gap: 0.75rem;
    padding: 0.65rem 1rem;
    border-radius: 12px;
    border: 1px solid rgba(0,196,154,0.2);
    background: linear-gradient(90deg, rgba(0,196,154,0.08) 0%, rgba(29,78,216,0.04) 100%);
  }
  .zenith-camps__stat-banner p {
    margin: 0; font-size: 12px;
    color: rgba(255,255,255,0.8);
    line-height: 1.45;
  }
  .zenith-camps__stat-banner strong {
    color: var(--zenith-lime);
    font-weight: 900;
  }

  .zenith-camps__grid {
    display: grid; gap: 2rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 1024px) { .zenith-camps__grid { grid-template-columns: 1fr 280px; } }
  .zenith-camps__pane { min-width: 0; }
  .zenith-camps__step[hidden] { display: none; }

  .zenith-camps__qnum {
    font-size: 11px; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.32em;
    color: var(--zenith-lime);
    margin: 0 0 0.65rem;
  }
  .zenith-camps__qtitle {
    font-size: clamp(1.5rem, 4vw, 2.75rem);
    font-weight: 900; line-height: 1.05;
    color: #fff;
    margin: 0 0 0.75rem;
  }
  .zenith-camps__qbody {
    font-size: 1rem;
    color: rgba(255,255,255,0.6);
    line-height: 1.6;
    margin: 0 0 1rem;
    max-width: 42rem;
  }
  .zenith-camps__qcount {
    font-size: 11px; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.18em;
    color: rgba(255,255,255,0.4);
    margin: 0 0 1.5rem;
  }
  .zenith-camps__qhint {
    margin-top: 1rem;
    font-size: 11px;
    color: rgba(255,255,255,0.4);
    font-style: italic;
  }

  .zenith-camps__opts { display: grid; gap: 0.55rem; }
  .zenith-camps__opts--grid2 { grid-template-columns: 1fr 1fr; }
  .zenith-camps__opts--grid3 { grid-template-columns: 1fr 1fr; }
  @media (min-width: 640px) {
    .zenith-camps__opts--grid3 { grid-template-columns: 1fr 1fr 1fr; }
  }
  .zenith-camps__opts--stack { grid-template-columns: 1fr; }

  .zenith-camps__opt {
    position: relative;
    background: rgba(255,255,255,0.05);
    border: 2px solid rgba(255,255,255,0.1);
    border-radius: 12px;
    padding: 1rem;
    text-align: left;
    color: #fff;
    cursor: pointer;
    transition: transform 0.15s, border-color 0.15s, background 0.15s;
  }
  .zenith-camps__opt:hover { border-color: rgba(0,196,154,0.4); transform: scale(1.02); }
  .zenith-camps__opt--active {
    background: var(--zenith-lime);
    border-color: var(--zenith-lime);
    color: var(--zenith-navy-deep);
  }
  .zenith-camps__opt--disabled {
    opacity: 0.4; cursor: not-allowed;
    background: rgba(255,255,255,0.02);
    border-color: rgba(255,255,255,0.05);
    transform: none !important;
  }
  .zenith-camps__opt--row {
    display: flex; align-items: center; gap: 0.75rem;
    padding: 1rem;
  }
  .zenith-camps__opt-check {
    position: absolute; top: 0.5rem; right: 0.5rem;
    width: 20px; height: 20px; border-radius: 50%;
    background: var(--zenith-navy-deep);
    color: var(--zenith-lime);
    font-size: 11px; font-weight: 900;
    display: none; align-items: center; justify-content: center;
  }
  .zenith-camps__opt--active .zenith-camps__opt-check { display: flex; }
  .zenith-camps__opt-emoji { font-size: 1.5rem; margin-bottom: 0.35rem; }
  .zenith-camps__opt-emoji--lg { font-size: 1.85rem; margin-bottom: 0.5rem; }
  .zenith-camps__opt-label { font-size: 1rem; font-weight: 700; }
  .zenith-camps__opt-note { font-size: 12px; opacity: 0.6; margin-top: 0.2rem; }
  .zenith-camps__opt--active .zenith-camps__opt-note { color: rgba(15,23,42,0.7); }

  .zenith-camps__field { display: flex; flex-direction: column; gap: 0.35rem; margin-bottom: 1rem; }
  .zenith-camps__field > span {
    font-size: 12px; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.22em;
