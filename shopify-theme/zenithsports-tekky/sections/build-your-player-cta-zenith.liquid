{% comment %}
  Build Your Player promo strip. A metric cluster on the left (what the
  tool gives you), copy in the middle, CTA on the right. Whole card is
  one big link. Speaks the same touches language as the rest of the site.
{% endcomment %}

<section class="zenith-section zenith-bypcta">
  <div class="zenith-container">
    <a href="{{ section.settings.cta_url | default: '/pages/build-your-player' }}" class="zenith-bypcta__card">
      <div class="zenith-bypcta__stats" aria-hidden="true">
        <div class="zenith-bypcta__stat">
          <span class="zenith-bypcta__stat-num">{{ section.settings.stat1_num | default: '4 week' | escape }}</span>
          <span class="zenith-bypcta__stat-lbl">{{ section.settings.stat1_label | default: 'custom plan' | escape }}</span>
        </div>
        <div class="zenith-bypcta__stat">
          <span class="zenith-bypcta__stat-num">{{ section.settings.stat2_num | default: '3 drills' | escape }}</span>
          <span class="zenith-bypcta__stat-lbl">{{ section.settings.stat2_label | default: 'hand-picked for their goals' | escape }}</span>
        </div>
        <div class="zenith-bypcta__stat">
          <span class="zenith-bypcta__stat-num">{{ section.settings.stat3_num | default: '375' | escape }}</span>
          <span class="zenith-bypcta__stat-lbl">{{ section.settings.stat3_label | default: 'deliberate touches / session' | escape }}</span>
        </div>
      </div>

      <div class="zenith-bypcta__copy">
        <div class="zenith-bypcta__chips">
          {% if section.settings.eyebrow != blank %}
            <span class="zenith-bypcta__badge">{{ section.settings.eyebrow | escape }}</span>
          {% endif %}
          <span class="zenith-bypcta__timer">60 seconds</span>
        </div>
        <h3 class="zenith-bypcta__heading">{{ section.settings.heading | escape }}</h3>
        {% if section.settings.body != blank %}
          <div class="zenith-bypcta__body">{{ section.settings.body }}</div>
        {% endif %}
      </div>

      <div class="zenith-bypcta__action">
        <span class="zenith-bypcta__btn">
          {{ section.settings.cta_label | escape }}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </span>
        <span class="zenith-bypcta__pillar">Parent · Player · Coach</span>
      </div>
    </a>
  </div>
</section>

<style>
  .zenith-bypcta {
    background: var(--zenith-navy-deep);
    padding: 4rem 0 1.75rem;
  }
  @media (min-width: 768px) { .zenith-bypcta { padding: 5rem 0; } }

  .zenith-bypcta__card {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    padding: 2rem 1.5rem;
    background: linear-gradient(135deg, #0a1832 0%, #050d1f 100%);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 1rem;
    text-decoration: none;
    color: #fff;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
    align-items: center;
    text-align: center;
  }
  @media (min-width: 1024px) {
    .zenith-bypcta__card {
      grid-template-columns: auto 1fr auto;
      gap: 2.5rem;
      padding: 2.5rem;
      text-align: left;
    }
  }
  .zenith-bypcta__card:hover {
    border-color: rgba(0,196,154,0.4);
    box-shadow: 0 0 40px rgba(0,196,154,0.12);
  }

  .zenith-bypcta__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.65rem;
    flex-shrink: 0;
    width: 100%;
  }
  @media (min-width: 1024px) {
    .zenith-bypcta__stats {
      grid-template-columns: 1fr;
      width: auto;
      min-width: 190px;
      gap: 0.75rem;
    }
  }
  .zenith-bypcta__stat {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.9rem 1rem;
    border-radius: 0.85rem;
    background: rgba(0,196,154,0.07);
    border: 1px solid rgba(0,196,154,0.28);
    text-align: center;
    transition: border-color 0.3s ease, background 0.3s ease;
  }
  @media (min-width: 1024px) { .zenith-bypcta__stat { text-align: left; } }
  .zenith-bypcta__card:hover .zenith-bypcta__stat {
    border-color: rgba(0,196,154,0.5);
    background: rgba(0,196,154,0.12);
  }
  .zenith-bypcta__stat-num {
    font-family: var(--zenith-font-display, 'Oswald', sans-serif);
    font-size: clamp(1.35rem, 3.4vw, 1.85rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--zenith-lime);
  }
  .zenith-bypcta__stat-lbl {
    font-size: 11px;
    font-weight: 700;
    line-height: 1.3;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgba(255,255,255,0.65);
  }

  .zenith-bypcta__chips {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.85rem;
    justify-content: center;
  }
  @media (min-width: 1024px) { .zenith-bypcta__chips { justify-content: flex-start; } }
  .zenith-bypcta__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.7rem;
    font-size: 12px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 800;
    border-radius: 999px;
    background: rgba(0,196,154,0.15);
    border: 1px solid rgba(0,196,154,0.35);
    color: var(--zenith-lime);
  }
  .zenith-bypcta__timer {
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 700;
    color: rgba(255,255,255,0.6);
  }
  .zenith-bypcta__heading {
    margin: 0;
    font-size: clamp(1.65rem, 4vw, 2.75rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 0.95;
    color: #fff;
  }
  .zenith-bypcta__body {
    margin-top: 0.9rem;
    color: rgba(255,255,255,0.85);
    font-size: 1.0625rem;
    line-height: 1.6;
    max-width: 36rem;
  }
  @media (min-width: 1024px) { .zenith-bypcta__body { margin-left: 0; } }

  .zenith-bypcta__action {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
  }
  @media (min-width: 1024px) { .zenith-bypcta__action { align-items: flex-end; } }
  .zenith-bypcta__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.95rem 1.5rem;
    background: var(--zenith-lime);
    color: var(--zenith-navy-deep);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    border-radius: 0.4rem;
    white-space: nowrap;
    box-shadow: 0 4px 16px rgba(0,0,0,0.2);
    transition: box-shadow 0.3s ease;
  }
  .zenith-bypcta__card:hover .zenith-bypcta__btn {
    box-shadow: 0 0 30px rgba(0,196,154,0.4);
  }
  .zenith-bypcta__pillar {
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.6);
  }
</style>

{% schema %}
{
  "name": "Zenith BYP CTA",
  "tag": "section",
  "class": "zenith-bypcta-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow badge", "default": "Free interactive tool" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get a plan built for your player." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Slide age, height, skill, and the sessions you'll commit to, and watch the touches climb in real time. You get a personalized 4-week plan on the spot — drills, hours, and the right TEKKY™ mix for where they are right now.</p>" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Build Your Player" },
    { "type": "text", "id": "cta_url", "label": "CTA URL", "default": "/pages/build-your-player" },
    { "type": "header", "content": "Metric cluster (3 left-to-right)" },
    { "type": "text", "id": "stat1_num", "label": "Stat 1 number", "default": "4 week" },
    { "type": "text", "id": "stat1_label", "label": "Stat 1 label", "default": "custom plan" },
    { "type": "text", "id": "stat2_num", "label": "Stat 2 number", "default": "3 drills" },
    { "type": "text", "id": "stat2_label", "label": "Stat 2 label", "default": "hand-picked for their goals" },
    { "type": "text", "id": "stat3_num", "label": "Stat 3 number", "default": "375" },
    { "type": "text", "id": "stat3_label", "label": "Stat 3 label", "default": "deliberate touches / session" }
  ],
  "presets": [
    { "name": "Zenith BYP CTA" }
  ]
}
{% endschema %}
