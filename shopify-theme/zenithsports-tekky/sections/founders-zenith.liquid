{% comment %}
  Zenith Sports / TEKKY™ founders section.
  Port of the "Meet TEKKY™" / founder cards from the Next.js site.
  Two cards: Philip + Paul.
{% endcomment %}

<section class="zenith-founders zenith-section zenith-section--ivory">
  <div class="zenith-container">
    {% if section.settings.eyebrow != blank %}
      <p class="zenith-eyebrow zenith-eyebrow--electric">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="zenith-h2" style="margin-top: 1.5rem; color: var(--zenith-navy-ink);">
        {{ section.settings.heading | escape }}
      </h2>
    {% endif %}

    {% if section.settings.intro != blank %}
      <div class="zenith-body" style="margin-top: 1.5rem; max-width: 42rem; font-size: clamp(1rem, 1.2vw, 1.125rem);">
        {{ section.settings.intro }}
      </div>
    {% endif %}

    <div class="zenith-founders__grid">
      {% for block in section.blocks %}
        <article class="zenith-founder-card">
          <div class="zenith-founder-card__photo">
            {% if block.settings.photo_url != blank %}
              <img
                src="{{ block.settings.photo_url }}"
                alt="{{ block.settings.name | escape }} -- {{ block.settings.role | escape }}"
                loading="lazy"
              >
            {% endif %}
          </div>
          <div class="zenith-founder-card__body">
            <p class="zenith-founder-card__role">{% render 'zenith-text', text: block.settings.role %}</p>
            <h3 class="zenith-founder-card__name">{{ block.settings.name | escape }}</h3>
            {% if block.settings.quote != blank %}
              <p class="zenith-founder-card__quote">
                &ldquo;{{ block.settings.quote | strip_html }}&rdquo;
              </p>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Zenith Founders",
  "tag": "section",
  "class": "zenith-founders-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The team behind TEKKY™"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built by coaches who've seen the gap."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro paragraph",
      "default": "<p>Philip Lund and Paul Hanson have spent 40+ combined years in U.S. youth soccer development -- coaching club, ECNL, MLS Next, and college programs. They built TEKKY™ because they kept seeing the same thing: U.S. players hit a technical ceiling at 17-18 that European players do not.</p>"
    }
  ],
  "blocks": [
    {
      "type": "founder",
      "name": "Founder card",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "photo_url",
          "label": "Photo URL (full external URL -- defaults to bespoke headshot)",
          "default": "https://zenithsports.org/cdn/shop/files/PhilipHeadShot.jpg"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Philip Lund"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role / sub-title",
          "default": "Co-Founder"
        },
        {
          "type": "richtext",
          "id": "quote",
          "label": "Quote / bio (1-3 sentences)",
          "default": "<p>To inspire kids to enjoy the process of improvement, build confidence, and fall in love with the game. This is not just about training -- it is about building a culture.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Zenith Founders",
      "blocks": [
        {
          "type": "founder",
          "settings": {
            "photo_url": "https://zenithsports.org/cdn/shop/files/PhilipHeadShot.jpg",
            "name": "Philip Lund",
            "role": "Co-Founder",
            "quote": "<p>To inspire kids to enjoy the process of improvement, build confidence, and fall in love with the game. This is not just about training -- it is about building a culture.</p>"
          }
        },
        {
          "type": "founder",
          "settings": {
            "photo_url": "https://zenithsports.org/cdn/shop/files/PaulHeadShot.jpg",
            "name": "Paul Hanson",
            "role": "Co-Founder | 40+ years in the game",
            "quote": "<p>I have spent extensive years coaching, always with a clear focus on true player development -- not just winning games. My approach remains rooted in long-term growth over short-term accolades.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
