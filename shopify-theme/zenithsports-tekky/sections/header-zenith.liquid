{% comment %}
  Zenith Sports / TEKKY sticky top nav. Replaces Dawn's default header
  for Zenith branding. Glass-morphism on scroll, mobile hamburger,
  primary "Buy the TEKKY" CTA on the right.

  Also the mount point for storefront analytics (Clarity / GA4 / Meta
  Pixel) — the header section is in the header group so it renders on
  every storefront page. Enter the ids in this section's customizer
  settings; tracking-zenith.liquid only emits a tag when its id is set.
{% endcomment %}

{% render 'tracking-zenith',
  clarity_id: section.settings.clarity_id,
  ga4_id: section.settings.ga4_id,
  meta_pixel_id: section.settings.meta_pixel_id
%}

<header class="zenith-nav" id="zenith-nav">
  <div class="zenith-nav__inner zenith-container">
    <a href="{{ routes.root_url }}" class="zenith-nav__brand">
      <img
        src="{{ 'zenith-logo-white.png' | asset_url }}"
        alt="{{ shop.name | escape }}"
        width="220"
        height="64"
      >
    </a>

    {%- assign nav_link_count = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'link' -%}
        {%- assign nav_link_count = nav_link_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
    <nav class="zenith-nav__links" aria-label="Primary">
      {% if nav_link_count > 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'link' %}
            <a href="{{ block.settings.url | default: '/' }}" {{ block.shopify_attributes }}>
              {{ block.settings.label | escape }}
            </a>
          {% endif %}
        {% endfor %}
      {% else %}
        <a href="/#who-its-for">Who's It For</a>
        <a href="/pages/shop">Shop</a>
        <a href="/pages/build-your-player">Build Your Player</a>
        <a href="/#contact">Contact</a>
      {% endif %}
    </nav>

    <div class="zenith-nav__cta-wrap">
      {%- assign nav_cta_text = section.settings.cta_label | default: 'Buy the TEKKY(TM)' -%}
      <a
        href="{{ section.settings.cta_url | default: '/cart/45347164389551:1' }}"
        class="zenith-btn zenith-btn--primary zenith-nav__cta"
      >
        {% render 'zenith-text', text: nav_cta_text %}
      </a>

      <button
        type="button"
        class="zenith-nav__hamburger"
        aria-controls="zenith-mobile-menu"
        aria-expanded="false"
        aria-label="Open menu"
        onclick="(function(b){var m=document.getElementById('zenith-mobile-menu');var open=m.getAttribute('data-open')==='true';m.setAttribute('data-open',open?'false':'true');b.setAttribute('aria-expanded',open?'false':'true');b.setAttribute('aria-label',open?'Open menu':'Close menu');})(this)"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="zenith-mobile-menu" id="zenith-mobile-menu" data-open="false">
    <nav aria-label="Mobile">
      <span class="zenith-mm__eyebrow">I'm a…</span>
      <div class="zenith-mm__aud">
        <a href="/pages/build-your-player" class="zenith-mm__chip">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="6" r="3"/><path d="M2.5 21v-1a5.5 5.5 0 0 1 11 0v1"/><circle cx="17.5" cy="9.5" r="2.2"/><path d="M14.8 21v-.5a3.4 3.4 0 0 1 6.7 0v.5"/></svg>
          <span>Parent</span>
        </a>
        <a href="/pages/build-your-player" class="zenith-mm__chip">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><path d="M12 7.3l3.4 2.5-1.3 4H9.9l-1.3-4 3.4-2.5z"/><path d="M12 7.3V3.6"/><path d="M15.4 9.8l3.4-1.2"/><path d="M14.1 13.8l2.2 3"/><path d="M9.9 13.8l-2.2 3"/><path d="M8.6 9.8 5.2 8.6"/></svg>
          <span>Player</span>
        </a>
        <a href="/pages/for-coaches?view=for-coaches" class="zenith-mm__chip">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4V3a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v1"/><path d="M9 10h6"/><path d="M9 14h6"/><path d="M9 18h4"/></svg>
          <span>Coach / Trainer</span>
        </a>
        <a href="/pages/for-docs?view=for-docs" class="zenith-mm__chip">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1.5"/><line x1="12" y1="5" x2="12" y2="19"/><circle cx="12" cy="12" r="2.4"/><path d="M3 9h2v6H3"/><path d="M21 9h-2v6h2"/></svg>
          <span>Director / Club</span>
        </a>
      </div>
      <div class="zenith-mm__divider"></div>
      <a href="/#who-its-for">Who's It For</a>
      <a href="/pages/shop">Shop</a>
      <a href="/pages/build-your-player">Build Your Player</a>
      <a href="/#contact">Contact</a>
      <a
        href="{{ section.settings.cta_url | default: '/cart/45347164389551:1' }}"
        class="zenith-btn zenith-btn--primary"
        style="margin-top: 1rem;"
      >
        {% render 'zenith-text', text: nav_cta_text %}
      </a>
    </nav>
  </div>

  <script>
    (function () {
      var m = document.getElementById('zenith-mobile-menu');
      if (!m) return;
      m.querySelectorAll('a').forEach(function (a) {
        a.addEventListener('click', function () { m.setAttribute('data-open', 'false'); });
      });
    })();
  </script>
</header>

<style>
  /* Stick the SECTION (a direct child of <body>, so it spans the whole page).
     Sticking the inner .zenith-nav fails because its parent section box is only
     header-tall — the sticky element can't travel beyond that short box. */
  .zenith-header-section {
    position: sticky;
    top: 48px;          /* matches the fixed .zenith-marquee height exactly -> no gap */
    z-index: 50;
  }
  .zenith-nav {
    position: relative;
    z-index: 50;
    background: rgba(10,24,50,0.92);
    backdrop-filter: saturate(140%) blur(8px);
    -webkit-backdrop-filter: saturate(140%) blur(8px);
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .zenith-nav__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding-top: 1rem;
    padding-bottom: 1rem;
  }
  .zenith-nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    justify-self: start;
    grid-column: 1;
  }
  .zenith-nav__brand img { display: block; max-height: 64px; width: auto; }
  @media (min-width: 768px) {
    .zenith-nav__brand img { max-height: 80px; }
  }
  @media (min-width: 1024px) {
    .zenith-nav__brand img { max-height: 92px; }
  }
  .zenith-nav__brand-text {
    color: #fff;
    font-weight: 900;
    text-transform: uppercase;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
  }
  @media (min-width: 768px) {
    .zenith-nav__brand-text { font-size: 1.5rem; }
  }
  @media (min-width: 1024px) {
    .zenith-nav__brand-text { font-size: 1.75rem; }
  }
  .zenith-nav__links {
    display: none;
    gap: 3.75rem;
    align-items: center;
    justify-content: center;
  }
  @media (min-width: 900px) {
    .zenith-nav__links { display: flex; }
  }
  @media (min-width: 1280px) {
    .zenith-nav__links { gap: 4.75rem; }
  }
  .zenith-nav__links a {
    color: rgba(255,255,255,0.92);
    font-family: var(--zenith-font-display);
    font-size: 17px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition: color 0.18s;
    white-space: nowrap;
  }
  @media (min-width: 1280px) {
    .zenith-nav__links a { font-size: 18.5px; }
  }
  .zenith-nav__links a:hover { color: var(--zenith-lime); }

  .zenith-nav__cta-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    justify-self: end;
    grid-column: 3;
  }
  .zenith-nav__cta { padding: 0.85rem 1.6rem; font-size: 13px; }
  @media (min-width: 1024px) { .zenith-nav__cta { padding: 1rem 1.85rem; font-size: 14px; } }
  @media (max-width: 640px) { .zenith-nav__cta { display: none; } }

  .zenith-nav__hamburger {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 40px;
    height: 40px;
    padding: 8px;
    background: transparent;
    border: 1px solid rgba(255,255,255,0.2);
    cursor: pointer;
  }
  @media (min-width: 900px) { .zenith-nav__hamburger { display: none; } }
  .zenith-nav__hamburger span {
    display: block;
    width: 100%;
    height: 2px;
    background: #fff;
  }

  .zenith-mobile-menu {
    display: none;
    background: var(--zenith-navy-deep);
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }
  .zenith-mobile-menu[data-open="true"] { display: block; }
  .zenith-mobile-menu nav {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem 1.25rem 2rem;
  }
  .zenith-mobile-menu nav a {
    display: block;
    padding: 0.95rem 1rem;
    color: #fff;
    text-decoration: none;
    font-family: var(--zenith-font-display);
    font-size: 16px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }
  .zenith-mobile-menu nav a:hover { color: var(--zenith-lime); }
  .zenith-mobile-menu nav a.zenith-btn--primary,
  .zenith-mobile-menu nav a.zenith-btn--primary:hover { color: #000; }

  /* Customer-type chips at the top of the mobile menu */
  .zenith-mm__eyebrow {
    display: block;
    font-family: var(--zenith-font-display);
    font-size: 11px; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.24em;
    color: var(--zenith-lime);
    margin: 0 0 0.65rem;
    padding: 0 0.15rem;
  }
  .zenith-mm__aud {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .zenith-mobile-menu nav a.zenith-mm__chip {
    display: flex; align-items: center; gap: 0.5rem;
    padding: 0.7rem 0.75rem;
    background: rgba(0,196,154,0.06);
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 0.7rem;
    color: #fff;
    font-size: 12.5px; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.04em;
    transition: border-color 0.18s, background 0.18s, color 0.18s;
  }
  .zenith-mobile-menu nav a.zenith-mm__chip svg {
    width: 18px; height: 18px;
    color: var(--zenith-lime);
    flex-shrink: 0;
  }
  .zenith-mobile-menu nav a.zenith-mm__chip:hover {
    border-color: var(--zenith-lime);
    background: rgba(0,196,154,0.14);
    color: #fff;
  }
  .zenith-mm__divider {
    height: 1px;
    background: rgba(255,255,255,0.1);
    margin: 0.25rem 0 0.85rem;
  }
</style>

{% schema %}
{
  "name": "Zenith Header",
  "tag": "section",
  "class": "zenith-header-section",
  "settings": [
    {
      "type": "text",
      "id": "logo_url",
      "label": "Logo URL (defaults to bespoke Zenith logo)",
      "default": "https://bluejayportfolio.com/zenith/zenith-logo-white.png"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Nav buy-CTA label",
      "default": "Buy the TEKKY(TM)"
    },
    {
      "type": "text",
      "id": "cta_url",
      "label": "Nav buy-CTA URL (default: direct add-to-cart for the ball)"
    },
    {
      "type": "header",
      "content": "Analytics & Tracking"
    },
    {
      "type": "paragraph",
      "content": "Storefront tags only (PageView + behavior). Each fires only when its id is filled. Checkout/purchase conversions still need the Google & YouTube + Meta sales-channel apps."
    },
    {
      "type": "text",
      "id": "clarity_id",
      "label": "Microsoft Clarity project id",
      "info": "From clarity.microsoft.com → your project → Settings → Setup (the code in clarity.ms/tag/XXXXXXXX)"
    },
    {
      "type": "text",
      "id": "ga4_id",
      "label": "GA4 Measurement id",
      "info": "Format G-XXXXXXXXXX — from Google Analytics → Admin → Data Streams"
    },
    {
      "type": "text",
      "id": "meta_pixel_id",
      "label": "Meta (Facebook) Pixel id",
      "info": "~15-digit number from Meta Events Manager"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Nav link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "url", "label": "URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Zenith Header",
      "blocks": [
        { "type": "link", "settings": { "label": "Shop" } },
        { "type": "link", "settings": { "label": "Build Your Player" } },
        { "type": "link", "settings": { "label": "Training Guide" } },
        { "type": "link", "settings": { "label": "Contact" } }
      ]
    }
  ]
}
{% endschema %}
